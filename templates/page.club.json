ss=\"amx-founding__form\"><input aria-label=\"Email\" type=\"email\" name=\"contact[email]\" required placeholder=\"{% if request.locale.iso_code == 'en' %}Your email{% else %}Twój e-mail{% endif %}\"><button data-amoura-track=\"founding50_signup\" type=\"submit\">{% if request.locale.iso_code == 'en' %}Join the founding panel{% else %}Dołącz do panelu{% endif %}</button></div>\n<p class=\"amx-founding__privacy\">{% if request.locale.iso_code == 'en' %}At signup we ask only for contact details. Do not include health or intimate information here.{% else %}Na etapie zapisu prosimy tylko o dane kontaktowe. Nie wpisuj tutaj informacji zdrowotnych ani intymnych.{% endif %}</p>\n{% if form.posted_successfully? %}<p>{% if request.locale.iso_code == 'en' %}Thank you. We will be in touch when the first panel round opens.{% else %}Dziękujemy. Odezwziemy się, kiedy otworzymy pierwszą rundę panelu.{% endif %}</p>{% endif %}\n{% endform %}\n</section>",
