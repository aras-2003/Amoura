    "why_amoura": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n.amx-why{position:relative;padding:86px 0 94px;overflow:hidden;background:#F4EDE7}\n.amx-why__orb{position:absolute;border-radius:999px;filter:blur(2px);pointer-events:none}\n.amx-why__orb--a{width:260px;height:260px;right:-100px;top:50px;background:rgba(199,167,181,.16)}\n.amx-why__orb--b{width:180px;height:180px;left:8%;bottom:-70px;background:rgba(74,16,42,.06)}\n.amx-why__head{position:relative;z-index:1;display:grid;grid-template-columns:.58fr 1.42fr;gap:64px;align-items:end;margin-bottom:46px}\n.amx-why__kicker{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#744D5E}\n.amx-why h2{font-family:Georgia,'Times New Roman',serif;font-size:clamp(42px,5.3vw,68px);line-height:.96;font-weight:400;color:#4A102A;margin:0;max-width:11ch}\n.amx-why__lead{font-size:16px;line-height:1.65;color:#3E3337;margin:18px 0 0;max-width:35rem}\n.amx-why__rail{position:relative;z-index:1;display:grid;grid-template-columns:repeat(3,1fr);gap:16px}\n.amx-why__card{position:relative;min-height:330px;padding:28px;background:#EFE5DF;border:1px solid rgba(74,16,42,.06);overflow:hidden;transition:transform .45s cubic-bezier(.2,.7,.2,1),background .35s ease}\n.amx-why__card:nth-child(2){background:#E9DCE3;transform:translateY(34px)}\n.amx-why__card:nth-child(3){background:#E7DED9;transform:translateY(68px)}\n.amx-why__card:hover{transform:translateY(-6px)}.amx-why__card:nth-child(2):hover{transform:translateY(24px)}.amx-why__card:nth-child(3):hover{transform:translateY(58px)}\n.amx-why__card:after{content:\"\";position:absolute;width:150px;height:150px;border-radius:50%;right:-70px;bottom:-70px;background:rgba(74,16,42,.06);transition:transform .55s ease}.amx-why__card:hover:after{transform:scale(1.2)}\n.amx-why__card span{font-size:11px;letter-spacing:.14em;color:#744D5E}\n.amx-why__card h3{font-family:Georgia,'Times New Roman',serif;font-size:30px;line-height:1;font-weight:400;color:#4A102A;margin:86px 0 12px}\n.amx-why__card p{font-size:14px;line-height:1.58;color:#3E3337;margin:0;max-width:25rem}\n@media(max-width:850px){.amx-why{padding:60px 0 66px}.amx-why__head,.amx-why__rail{grid-template-columns:1fr}.amx-why__head{gap:16px;margin-bottom:28px}.amx-why__rail{gap:10px}.amx-why__card,.amx-why__card:nth-child(2),.amx-why__card:nth-child(3){min-height:0;transform:none}.amx-why__card:hover,.amx-why__card:nth-child(2):hover,.amx-why__card:nth-child(3):hover{transform:translateY(-3px)}.amx-why__card h3{margin:42px 0 10px}}\n</style>\n<section class=\"amx-why\">\n<div class=\"amx-why__orb amx-why__orb--a\" data-amoura-parallax></div><div class=\"amx-why__orb amx-why__orb--b\"></div>\n<div class=\"amx-why__head\">\n<div><div class=\"amx-why__kicker\" data-amoura-reveal>{% if request.locale.iso_code == 'en' %}Why Amoura{% else %}Dlaczego Amoura{% endif %}</div></div>\n<div><h2 data-amoura-reveal>{% if request.locale.iso_code == 'en' %}A quieter way to make intimate choices.{% else %}Spokojniejszy sposób podejmowania intymnych decyzji.{% endif %}</h2><p class=\"amx-why__lead\" data-amoura-reveal>{% if request.locale.iso_code == 'en' %}Less catalogue, less noise, more confidence that what you see has a reason to be here.{% else %}Mniej katalogu, mniej szumu i więcej pewności, że to, co widzisz, ma powód, żeby tu być.{% endif %}</p></div>\n</div>\n<div class=\"amx-why__rail\">\n<div class=\"amx-why__card\" data-amoura-reveal><span>01</span><h3>{% if request.locale.iso_code == 'en' %}Curated{% else %}Wybrane{% endif %}</h3><p>{% if request.locale.iso_code == 'en' %}A smaller assortment built around real needs, not endless categories.{% else %}Mniejszy wybór zbudowany wokół realnych potrzeb, nie nieskończonych kategorii.{% endif %}</p></div>\n<div class=\"amx-why__card\" data-amoura-reveal><span>02</span><h3>{% if request.locale.iso_code == 'en' %}Explained{% else %}Wyjaśnione{% endif %}</h3><p>{% if request.locale.iso_code == 'en' %}Context before claims. Useful knowledge before purchase pressure.{% else %}Kontekst przed obietnicą. Użyteczna wiedza przed presją zakupową.{% endif %}</p></div>\n<div class=\"amx-why__card\" data-amoura-reveal><span>03</span><h3>{% if request.locale.iso_code == 'en' %}Verified{% else %}Sprawdzone{% endif %}</h3><p>{% if request.locale.iso_code == 'en' %}What is verified, still being checked or not declared should always be visible.{% else %}Ma być jasne, co jest zweryfikowane, co jeszcze sprawdzamy, a czego nie deklarujemy.{% endif %}</p></div>\n</div></section>",
