      "settings": {
        "custom_liquid": "<style>\n.amx-standard{padding:82px 0 78px}\n.amx-standard__intro{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(320px,.8fr);gap:72px;align-items:end;margin-bottom:54px}\n.amx-standard__lead{max-width:58rem}\n.amx-standard__eyebrow{display:flex;align-items:center;gap:14px;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:#744D5E;margin-bottom:22px}\n.amx-standard__eyebrow:before{content:\"\";width:38px;height:1px;background:rgba(74,16,42,.28)}\n.amx-standard h2{font-family:Georgia,'Times New Roman',serif;font-size:clamp(42px,4.5vw,66px);line-height:.98;font-weight:400;color:#4A102A;margin:0;max-width:16ch;letter-spacing:-.035em;text-wrap:balance}\n.amx-standard__intro p{font-size:16px;line-height:1.7;color:#3E3337;margin:0;max-width:36rem}\n.amx-standard__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid rgba(74,16,42,.16);border-bottom:1px solid rgba(74,16,42,.16)}\n.amx-standard__criterion{position:relative;padding:30px 28px 32px;border-right:1px solid rgba(74,16,42,.14);min-height:286px;transition:background .3s ease,transform .3s ease}\n.amx-standard__criterion:last-child{border-right:0}\n.amx-standard__criterion:hover{background:rgba(74,16,42,.024)}\n.amx-standard__icon{width:46px;height:46px;display:grid;place-items:center;margin-bottom:54px;color:#4A102A}\n.amx-standard__icon svg{width:40px;height:40px;stroke:currentColor;fill:none;stroke-width:1.35;stroke-linecap:round;stroke-linejoin:round}\n.amx-standard__criterion h3{font-family:Georgia,'Times New Roman',serif;font-size:clamp(24px,2vw,31px);line-height:1.03;font-weight:400;color:#4A102A;margin:0 0 14px;letter-spacing:-.018em}\n.amx-standard__criterion p{font-size:14px;line-height:1.66;color:#51454A;margin:0;max-width:27rem}\n.amx-standard__criterion small{display:block;margin-top:18px;font-size:11px;line-height:1.5;letter-spacing:.03em;color:#8B6E7A}\n.amx-standard__proof{margin-top:58px;padding-top:34px;border-top:1px solid rgba(74,16,42,.18)}\n.amx-standard__proof-head{display:grid;grid-template-columns:minmax(0,.85fr) minmax(320px,1.15fr);gap:64px;align-items:start;margin-bottom:28px}\n.amx-standard__proof h3{font-family:Georgia,'Times New Roman',serif;font-size:clamp(31px,3vw,44px);line-height:1.02;font-weight:400;color:#4A102A;margin:0;max-width:12ch;letter-spacing:-.02em}\n.amx-standard__proof-note{font-size:14px;line-height:1.65;color:#6A5960;margin:4px 0 0;max-width:36rem}\n.amx-standard__states{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid rgba(74,16,42,.14);border-bottom:1px solid rgba(74,16,42,.14)}\n.amx-standard__state{padding:24px 28px 26px;border-right:1px solid rgba(74,16,42,.14)}\n.amx-standard__state:last-child{border-right:0}\n.amx-standard__state strong{display:flex;align-items:center;gap:10px;color:#4A102A;font-size:14px;margin-bottom:10px}\n.amx-standard__state strong:before{content:\"\";width:7px;height:7px;border-radius:50%;background:#4A102A;opacity:.72}\n.amx-standard__state:nth-child(2) strong:before{background:#9B6D7F}\n.amx-standard__state:nth-child(3) strong:before{background:transparent;border:1px solid #9B6D7F}\n.amx-standard__state p{margin:0;color:#3E3337;font-size:13px;line-height:1.58}\n.amx-standard__refs{margin-top:44px;padding:28px 0 0;border-top:1px solid rgba(74,16,42,.14);display:grid;grid-template-columns:minmax(0,.55fr) minmax(0,1.45fr);gap:48px}\n.amx-standard__refs h4{font-family:Georgia,'Times New Roman',serif;font-size:26px;line-height:1.05;font-weight:400;color:#4A102A;margin:0}\n.amx-standard__refs p{font-size:13px;line-height:1.7;color:#5B4D53;margin:0;max-width:58rem}\n.amx-standard__refs strong{font-weight:600;color:#4A102A}\n@media(max-width:1100px){.amx-standard__grid{grid-template-columns:repeat(2,minmax(0,1fr))}.amx-standard__criterion:nth-child(2){border-right:0}.amx-standard__criterion:nth-child(-n+2){border-bottom:1px solid rgba(74,16,42,.14)}}\n@media(max-width:850px){.amx-standard__intro{grid-template-columns:1fr;gap:22px;margin-bottom:40px}.amx-standard__intro p{max-width:42rem}.amx-standard__proof-head,.amx-standard__refs{grid-template-columns:1fr;gap:14px}.amx-standard__states{grid-template-columns:1fr}.amx-standard__state{border-right:0;border-bottom:1px solid rgba(74,16,42,.14)}.amx-standard__state:last-child{border-bottom:0}}\n@media(max-width:749px){.amx-standard{padding:56px 0 60px}.amx-standard h2{font-size:clamp(39px,11vw,54px);max-width:11ch}.amx-standard__grid{grid-template-columns:1fr}.amx-standard__criterion{min-height:0;border-right:0;border-bottom:1px solid rgba(74,16,42,.14);padding:26px 0 28px}.amx-standard__criterion:last-child{border-bottom:0}.amx-standard__criterion:nth-child(-n+2){border-bottom:1px solid rgba(74,16,42,.14)}.amx-standard__icon{margin-bottom:30px}.amx-standard__state{padding:20px 0}}\n</style>\n<section class=\"amx-standard\" id=\"amoura-standard\">\n  <div class=\"amx-standard__intro\">\n    <div class=\"amx-standard__lead\">\n      <div class=\"amx-standard__eyebrow\">{% if request.locale.iso_code == 'en' %}How we choose products{% else %}Jak wybieramy produkty{% endif %}</div>\n      <h2>{% if request.locale.iso_code == 'en' %}A standard you can see before you choose.{% else %}Standard, który widać zanim wybierzesz.{% endif %}</h2>\n    </div>\n    <p>{% if request.locale.iso_code == 'en' %}Every product has to earn its place in the assortment. We look at the same four areas and show what has actually been checked — instead of asking you to trust aesthetics alone.{% else %}Każdy produkt musi zasłużyć na miejsce w selekcji. Oceniamy go według tych samych czterech obszarów i pokazujemy, co faktycznie zostało sprawdzone — zamiast oczekiwać zaufania do samej estetyki.{% endif %}</p>\n  </div>\n\n  <div class=\"amx-standard__grid\">\n    <article class=\"amx-standard__criterion\" data-amoura-reveal>\n      <div class=\"amx-standard__icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 48 48\"><path d=\"M24 5 39 11v11c0 10-6.2 17.1-15 21-8.8-3.9-15-11-15-21V11L24 5Z\"/><path d=\"m17.5 24 4.2 4.2L31 18.8\"/></svg>\n      </div>\n      <h3>{% if request.locale.iso_code == 'en' %}Safety{% else %}Bezpieczeństwo{% endif %}</h3>\n      <p>{% if request.locale.iso_code == 'en' %}We verify materials, intended use and the supplier documentation relevant to the product category. Claims about safety appear only when there is evidence behind them.{% else %}Weryfikujemy materiały, przeznaczenie produktu i dokumentację dostawcy właściwą dla danej kategorii. Deklarujemy bezpieczeństwo tylko wtedy, gdy stoi za nim konkretny dowód.{% endif %}</p>\n      <small>{% if request.locale.iso_code == 'en' %}materials · intended use · documentation{% else %}materiały · przeznaczenie · dokumentacja{% endif %}</small>\n    </article>\n\n    <article class=\"amx-standard__criterion\" data-amoura-reveal>\n      <div class=\"amx-standard__icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 48 48\"><path d=\"M15 31V18.5a3 3 0 0 1 6 0V26\"/><path d=\"M21 24V15.5a3 3 0 0 1 6 0V25\"/><path d=\"M27 24v-6.5a3 3 0 0 1 6 0V26\"/><path d=\"M33 24.5V22a3 3 0 0 1 6 0v8c0 8-5.5 13-13 13-6.8 0-11-3.4-14-9.5l-3.2-6.2a3 3 0 0 1 5.2-3l3 4.7\"/></svg>\n      </div>\n      <h3>{% if request.locale.iso_code == 'en' %}Use & ergonomics{% else %}Użytkowanie i ergonomia{% endif %}</h3>\n      <p>{% if request.locale.iso_code == 'en' %}We look at comfort, controls, cleaning and whether the product is genuinely intuitive in everyday use. Good design should reduce friction, not add instructions.{% else %}Oceniamy komfort, sterowanie, czyszczenie i to, czy produkt jest naprawdę intuicyjny w codziennym użyciu. Dobry design ma upraszczać doświadczenie, a nie wymagać instrukcji do każdej czynności.{% endif %}</p>\n      <small>{% if request.locale.iso_code == 'en' %}comfort · controls · cleaning{% else %}komfort · sterowanie · czyszczenie{% endif %}</small>\n    </article>\n\n    <article class=\"amx-standard__criterion\" data-amoura-reveal>\n      <div class=\"amx-standard__icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 48 48\"><path d=\"m24 6 5.2 10.8L41 18.5l-8.5 8.3 2 11.7L24 33l-10.5 5.5 2-11.7L7 18.5l11.8-1.7L24 6Z\"/></svg>\n      </div>\n      <h3>{% if request.locale.iso_code == 'en' %}Quality in real use{% else %}Jakość w realnym użyciu{% endif %}</h3>\n      <p>{% if request.locale.iso_code == 'en' %}We assess durability and the details that matter after the studio photo: charging, seals where relevant, noise, finish and discretion during normal use.{% else %}Oceniamy trwałość oraz detale, które mają znaczenie już po zdjęciu studyjnym: ładowanie, szczelność tam, gdzie jest istotna, hałas, wykończenie i dyskrecję w normalnym użyciu.{% endif %}</p>\n      <small>{% if request.locale.iso_code == 'en' %}durability · finish · discretion{% else %}trwałość · wykończenie · dyskrecja{% endif %}</small>\n    </article>\n\n    <article class=\"amx-standard__criterion\" data-amoura-reveal>\n      <div class=\"amx-standard__icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 48 48\"><circle cx=\"15\" cy=\"16\" r=\"6\"/><circle cx=\"33\" cy=\"32\" r=\"6\"/><path d=\"M20 19.5 28 28.5\"/><path d=\"M28 12h9v9\"/><path d=\"M37 12 27 22\"/><path d=\"M20 36h-9v-9\"/><path d=\"m11 36 10-10\"/></svg>\n      </div>\n      <h3>{% if request.locale.iso_code == 'en' %}Origin & accountability{% else %}Pochodzenie i odpowiedzialność{% endif %}</h3>\n      <p>{% if request.locale.iso_code == 'en' %}We want to know who stands behind the product, what evidence is available and who takes responsibility when something goes wrong — including warranty and support.{% else %}Chcemy wiedzieć, kto stoi za produktem, jakie dowody są dostępne i kto bierze odpowiedzialność, gdy coś pójdzie nie tak — razem z gwarancją i obsługą posprzedażową.{% endif %}</p>\n      <small>{% if request.locale.iso_code == 'en' %}origin · evidence · support{% else %}pochodzenie · dowody · wsparcie{% endif %}</small>\n    </article>\n  </div>\n\n  <div class=\"amx-standard__proof\">\n    <div class=\"amx-standard__proof-head\">\n      <h3>{% if request.locale.iso_code == 'en' %}Three proof states.{% else %}Trzy statusy dowodu.{% endif %}</h3>\n      <p class=\"amx-standard__proof-note\">{% if request.locale.iso_code == 'en' %}One simple rule: the strength of the claim should never exceed the strength of the evidence.{% else %}Jedna prosta zasada: siła deklaracji nie może być większa niż siła dowodu.{% endif %}</p>\n    </div>\n    <div class=\"amx-standard__states\">\n      <div class=\"amx-standard__state\"><strong>{% if request.locale.iso_code == 'en' %}Verified{% else %}Zweryfikowane{% endif %}</strong><p>{% if request.locale.iso_code == 'en' %}Documented and checked against the final product or supplier evidence.{% else %}Udokumentowane i sprawdzone na finalnym produkcie lub dokumentacji dostawcy.{% endif %}</p></div>\n      <div class=\"amx-standard__state\"><strong>{% if request.locale.iso_code == 'en' %}In validation{% else %}W walidacji{% endif %}</strong><p>{% if request.locale.iso_code == 'en' %}A candidate exists, but evidence is not yet sufficient for a final claim.{% else %}Mamy kandydata, ale dowodów jest jeszcze za mało na finalną deklarację.{% endif %}</p></div>\n      <div class=\"amx-standard__state\"><strong>{% if request.locale.iso_code == 'en' %}Not declared{% else %}Nie deklarujemy{% endif %}</strong><p>{% if request.locale.iso_code == 'en' %}If we cannot verify it, it does not appear as a benefit.{% else %}Jeśli nie potrafimy czegoś zweryfikować, nie pokazujemy tego jako korzyści.{% endif %}</p></div>\n    </div>\n  </div>\n  <div class=\"amx-standard__refs\">\n    <h4>{% if request.locale.iso_code == 'en' %}Reference framework{% else %}Ramy odniesienia{% endif %}</h4>\n    <p>{% if request.locale.iso_code == 'en' %}The applicable requirements depend on the product category. Our validation model is designed to map, where relevant, to the EU General Product Safety Regulation (GPSR), REACH restrictions for substances in articles, and for electrical products also RoHS and electromagnetic-compatibility requirements. For manufactured products intended for direct contact with genitalia or the anus, ISO 3533:2021 is an important safety and user-information benchmark. These references are used as a validation framework; a product is described as compliant only after the relevant evidence has been reviewed.{% else %}Zakres wymagań zależy od kategorii produktu. Model walidacji projektujemy tak, aby — tam, gdzie ma to zastosowanie — uwzględniał Rozporządzenie GPSR dotyczące ogólnego bezpieczeństwa produktów, ograniczenia REACH dla substancji w wyrobach, a dla produktów elektrycznych również wymagania RoHS i kompatybilności elektromagnetycznej. Dla wyrobów przeznaczonych do bezpośredniego kontaktu z genitaliami lub odbytem ważnym punktem odniesienia jest ISO 3533:2021 dotycząca bezpieczeństwa konstrukcji, materiałów i informacji dla użytkownika. Traktujemy te ramy jako benchmark walidacji; zgodność deklarujemy dopiero po sprawdzeniu odpowiednich dowodów.{% endif %}</p>\n  </div>\n</section>",
        "background_color": "#F4EDE7",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
