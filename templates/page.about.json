12ch;letter-spacing:-.018em}\n.amx-about-story__step p{position:relative;z-index:2;font-size:14px;line-height:1.65;color:rgba(244,237,231,.7);margin:0;max-width:28rem}\n.amx-about-story__step:after{content:attr(data-num);position:absolute;right:22px;top:18px;font-family:Georgia,'Times New Roman',serif;font-size:86px;line-height:1;color:rgba(244,237,231,.035);letter-spacing:-.06em;pointer-events:none;transition:color .35s ease,transform .35s ease}\n.amx-about-story__step:hover:after{color:rgba(244,237,231,.06);transform:translateY(4px)}\n@media(max-width:980px){.amx-about-story{padding:68px 34px 0}.amx-about-story__head{grid-template-columns:1fr;gap:24px;margin-bottom:54px}.amx-about-story__head p{max-width:42rem}.amx-about-story__steps{margin-inline:-34px}.amx-about-story__step{padding-inline:28px}}\n@media(max-width:760px){.amx-about-story{padding:54px 24px 0}.amx-about-story__head{gap:18px;margin-bottom:42px}.amx-about-story__head h2{font-size:clamp(40px,12.2vw,58px);max-width:11.5ch}.amx-about-story__head p{font-size:16px}.amx-about-story__steps{grid-template-columns:1fr;margin-inline:-24px}.amx-about-story__step{min-height:0;border-right:0;border-bottom:1px solid rgba(244,237,231,.14);padding:24px 24px 28px}.amx-about-story__step h3{margin:34px 0 10px;max-width:none}.amx-about-story__step:after{font-size:70px;right:18px;top:14px}}\n</style>\n<section class=\"amx-about-story\">\n  <div class=\"amx-about-story__head\">\n    <div class=\"amx-about-story__principle\" data-amoura-reveal>{% if request.locale.iso_code == 'en' %}How Amoura works{% else %}Jak działa Amoura{% endif %}</div>\n    <h2 data-amoura-reveal>{% if request.locale.iso_code == 'en' %}We do not start with selling. We start with understanding.{% else %}Nie zaczynamy od sprzedaży. Zaczynamy od zrozumienia.{% endif %}</h2>\n    <p data-amoura-reveal>{% if request.locale.iso_code == 'en' %}Trust comes first. Then language and knowledge. The product appears only when it becomes the natural next step — not the beginning of the conversation.{% else %}Najpierw budujemy zaufanie. Potem dajemy język i wiedzę. Produkt pojawia się dopiero wtedy, gdy staje się naturalnym kolejnym krokiem — nie początkiem rozmowy.{% endif %}</p>\n  </div>\n  <div class=\"amx-about-story__steps\">\n    <div class=\"amx-about-story__step\" data-num=\"01\" data-amoura-reveal><span>01 · {% if request.locale.iso_code == 'en' %}belonging{% else %}przynależność{% endif %}</span><h3>{% if request.locale.iso_code == 'en' %}A space without shame.{% else %}Przestrzeń bez wstydu.{% endif %}</h3><p>{% if request.locale.iso_code == 'en' %}A calm, mature context in which intimacy can be talked about without embarrassment, clichés or pressure.{% else %}Spokojny, dojrzały kontekst, w którym o intymności można mówić bez skrępowania, stereotypów i presji.{% endif %}</p></div>\n    <div class=\"amx-about-story__step\" data-num=\"02\" data-amoura-reveal><span>02 · {% if request.locale.iso_code == 'en' %}language{% else %}język i wiedza{% endif %}</span><h3>{% if request.locale.iso_code == 'en' %}Understand before choosing.{% else %}Najpierw zrozumienie.{% endif %}</h3><p>{% if request.locale.iso_code == 'en' %}Useful education and expert context help turn an unclear need into a more confident, informed decision.{% else %}Użyteczna edukacja i kontekst ekspercki pomagają zamienić niejasną potrzebę w spokojniejszą, bardziej świadomą decyzję.{% endif %}</p></div>\n    <div class=\"amx-about-story__step\" data-num=\"03\" data-amoura-reveal><span>03 · {% if request.locale.iso_code == 'en' %}choice{% else %}wybór{% endif %}</span><h3>{% if request.locale.iso_code == 'en' %}Curated, not catalogued.{% else %}Kuratorujemy, nie katalogujemy.{% endif %}</h3><p>{% if request.locale.iso_code == 'en' %}Fewer products, each with a clear role. The purchase should feel like the right next step, not a leap into an overwhelming category.{% else %}Mniej produktów, każdy z jasną rolą. Zakup ma być właściwym kolejnym krokiem, a nie skokiem w przytłaczającą kategorię.{% endif %}</p></div>\n  </div>\n</section>",
