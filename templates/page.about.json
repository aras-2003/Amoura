    "standard": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n.amx-standard{padding:86px 0 84px}\n.amx-standard__intro{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(320px,.85fr);gap:80px;align-items:end;margin-bottom:58px}\n.amx-standard__lead{max-width:60rem}\n.amx-standard__eyebrow{display:flex;align-items:center;gap:14px;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:#744D5E;margin-bottom:22px}\n.amx-standard__eyebrow:before{content:\"\";width:38px;height:1px;background:rgba(74,16,42,.28)}\n.amx-standard h2{font-family:Georgia,'Times New Roman',serif;font-size:clamp(44px,4.6vw,68px);line-height:.97;font-weight:400;color:#4A102A;margin:0;max-width:16ch;letter-spacing:-.038em;text-wrap:balance}\n.amx-standard__intro p{font-size:16px;line-height:1.72;color:#3E3337;margin:0;max-width:36rem}\n\n.amx-standard__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:72px;row-gap:0;border-top:1px solid rgba(74,16,42,.14);border-bottom:1px solid rgba(74,16,42,.14)}\n.amx-standard__criterion{position:relative;display:grid;grid-template-columns:64px 1fr;gap:24px;padding:34px 0 36px;min-height:210px}\n.amx-standard__criterion:nth-child(odd){padding-right:36px}\n.amx-standard__criterion:nth-child(even){padding-left:36px}\n.amx-standard__criterion:nth-child(-n+2){border-bottom:1px solid rgba(74,16,42,.12)}\n.amx-standard__icon{width:54px;height:54px;border:1px solid rgba(74,16,42,.16);border-radius:50%;display:grid;place-items:center;color:#4A102A;background:rgba(255,255,255,.16)}\n.amx-standard__icon svg{width:28px;height:28px;stroke:currentColor;fill:none;stroke-width:1.35;stroke-linecap:round;stroke-linejoin:round}\n.amx-standard__criterion h3{font-family:Georgia,'Times New Roman',serif;font-size:clamp(25px,2vw,31px);line-height:1.04;font-weight:400;color:#4A102A;margin:2px 0 12px;letter-spacing:-.018em}\n.amx-standard__criterion p{font-size:14px;line-height:1.68;color:#51454A;margin:0;max-width:31rem}\n.amx-standard__criterion small{display:block;margin-top:14px;font-size:10px;line-height:1.5;letter-spacing:.08em;text-transform:uppercase;color:#957985}\n\n.amx-standard__proof{margin-top:64px}\n.amx-standard__proof-head{display:grid;grid-template-columns:minmax(0,.8fr) minmax(320px,1.2fr);gap:64px;align-items:end;margin-bottom:28px}\n.amx-standard__proof h3{font-family:Georgia,'Times New Roman',serif;font-size:clamp(32px,3vw,45px);line-height:1.01;font-weight:400;color:#4A102A;margin:0;max-width:11ch;letter-spacing:-.022em}\n.amx-standard__proof-note{font-size:14px;line-height:1.65;color:#6A5960;margin:0;max-width:36rem}\n.amx-standard__states{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}\n.amx-standard__state{position:relative;padding:22px 22px 24px;border:1px solid rgba(74,16,42,.13);background:rgba(255,255,255,.14);min-height:138px}\n.amx-standard__state:before{content:\"\";position:absolute;left:0;top:0;bottom:0;width:3px;background:#4A102A}\n.amx-standard__state:nth-child(2):before{background:#A48291}\n.amx-standard__state:nth-child(3):before{background:transparent;border-left:1px solid #A48291}\n.amx-standard__state strong{display:block;color:#4A102A;font-size:14px;margin-bottom:10px}\n.amx-standard__state p{margin:0;color:#3E3337;font-size:13px;line-height:1.6}\n\n.amx-standard__refs{margin-top:58px;padding:34px 0 0;border-top:1px solid rgba(74,16,42,.16);display:grid;grid-template-columns:minmax(0,.55fr) minmax(0,1.45fr);gap:56px}\n.amx-standard__refs h4{font-family:Georgia,'Times New Roman',serif;font-size:30px;line-height:1.04;font-weight:400;color:#4A102A;margin:0}\n.amx-standard__refs-copy p{font-size:13px;line-height:1.72;color:#5B4D53;margin:0;max-width:58rem}\n.amx-standard__badges{display:flex;flex-wrap:wrap;gap:10px;margin:18px 0 16px}\n.amx-standard__badge{display:inline-flex;align-items:center;min-height:34px;padding:7px 11px;border:1px solid rgba(74,16,42,.17);border-radius:999px;font-size:11px;letter-spacing:.04em;color:#4A102A;background:rgba(255,255,255,.2)}\n.amx-standard__refs-note{font-size:11px!important;line-height:1.55!important;color:#8A707B!important}\n\n@media(max-width:900px){.amx-standard__intro,.amx-standard__proof-head,.amx-standard__refs{grid-template-columns:1fr;gap:22px}.amx-standard__grid{column-gap:34px}.amx-standard__states{grid-template-columns:1fr}.amx-standard__state{min-height:0}}\n@media(max-width:749px){.amx-standard{padding:58px 0 64px}.amx-standard h2{font-size:clamp(40px,11vw,56px);max-width:11ch}.amx-standard__grid{grid-template-columns:1fr}.amx-standard__criterion{grid-template-columns:52px 1fr;gap:18px;padding:28px 0!important;border-bottom:1px solid rgba(74,16,42,.12)}.amx-standard__criterion:last-child{border-bottom:0}.amx-standard__icon{width:46px;height:46px}.amx-standard__proof{margin-top:48px}.amx-standard__refs{margin-top:46px}}\n</style>\n<section class=\"amx-standard\" id=\"amoura-standard\">\n  <div class=\"amx-standard__intro\">\n    <div class=\"amx-standard__lead\">\n      <div class=\"amx-standard__eyebrow\">{% if request.locale.iso_code == 'en' %}How we choose products{% else %}Jak wybieramy produkty{% endif %}</div>\n      <h2>{% if request.locale.iso_code == 'en' %}A standard you can see before you choose.{% else %}Standard, który widać zanim wybierzesz.{% endif %}</h2>\n    </div>\n    <p>{% if request.locale.iso_code == 'en' %}Every product has to earn its place in the assortment. We assess the same four dimensions and show what was actually reviewed — not what merely looks premium in a studio photo.{% else %}Każdy produkt musi zasłużyć na miejsce w selekcji. Oceniamy go według tych samych czterech wymiarów i pokazujemy, co faktycznie zostało sprawdzone — nie tylko to, co dobrze wygląda na zdjęciu studyjnym.{% endif %}</p>\n  </div>\n\n  <div class=\"amx-standard__grid\">\n    <article class=\"amx-standard__criterion\" data-amoura-reveal>\n      <div class=\"amx-standard__icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 48 48\"><path d=\"M24 5 39 11v11c0 10-6.2 17.1-15 21-8.8-3.9-15-11-15-21V11L24 5Z\"/><path d=\"m17.5 24 4.2 4.2L31 18.8\"/></svg></div>\n      <div><h3>{% if request.locale.iso_code == 'en' %}Safety & material evidence{% else %}Bezpieczeństwo i materiały{% endif %}</h3><p>{% if request.locale.iso_code == 'en' %}We review material declarations, intended use, warnings and supplier documentation appropriate to the category. A safety claim is shown only when the supporting evidence is available and relevant.{% else %}Sprawdzamy deklaracje materiałowe, przeznaczenie, ostrzeżenia i dokumentację dostawcy właściwą dla danej kategorii. Informację o bezpieczeństwie pokazujemy tylko wtedy, gdy istnieje adekwatny dowód.{% endif %}</p><small>{% if request.locale.iso_code == 'en' %}materials · warnings · documentation{% else %}materiały · ostrzeżenia · dokumentacja{% endif %}</small></div>\n    </article>\n\n    <article class=\"amx-standard__criterion\" data-amoura-reveal>\n      <div class=\"amx-standard__icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 48 48\"><path d=\"M15 31V18.5a3 3 0 0 1 6 0V26\"/><path d=\"M21 24V15.5a3 3 0 0 1 6 0V25\"/><path d=\"M27 24v-6.5a3 3 0 0 1 6 0V26\"/><path d=\"M33 24.5V22a3 3 0 0 1 6 0v8c0 8-5.5 13-13 13-6.8 0-11-3.4-14-9.5l-3.2-6.2a3 3 0 0 1 5.2-3l3 4.7\"/></svg></div>\n      <div><h3>{% if request.locale.iso_code == 'en' %}Use, ergonomics & care{% else %}Użytkowanie, ergonomia i pielęgnacja{% endif %}</h3><p>{% if request.locale.iso_code == 'en' %}We assess comfort, controls, cleaning guidance, charging where relevant and whether the product can be used intuitively without avoidable friction or ambiguity.{% else %}Oceniamy komfort, sterowanie, sposób czyszczenia, ładowanie tam, gdzie ma znaczenie, oraz to, czy produkt można używać intuicyjnie i bez niepotrzebnych barier.{% endif %}</p><small>{% if request.locale.iso_code == 'en' %}comfort · controls · cleaning{% else %}komfort · sterowanie · czyszczenie{% endif %}</small></div>\n    </article>\n\n    <article class=\"amx-standard__criterion\" data-amoura-reveal>\n      <div class=\"amx-standard__icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 48 48\"><path d=\"m24 6 5.2 10.8L41 18.5l-8.5 8.3 2 11.7L24 33l-10.5 5.5 2-11.7L7 18.5l11.8-1.7L24 6Z\"/></svg></div>\n      <div><h3>{% if request.locale.iso_code == 'en' %}Quality in real use{% else %}Jakość w realnym użyciu{% endif %}</h3><p>{% if request.locale.iso_code == 'en' %}We look beyond first impressions: durability, finish, noise, seals where relevant, charging behaviour and discretion in normal use. Quality should survive everyday handling, not only presentation.{% else %}Patrzymy dalej niż pierwsze wrażenie: na trwałość, wykończenie, hałas, szczelność tam, gdzie jest istotna, zachowanie podczas ładowania i dyskrecję w normalnym użyciu. Jakość ma działać na co dzień, nie tylko dobrze wyglądać.{% endif %}</p><small>{% if request.locale.iso_code == 'en' %}durability · finish · discretion{% else %}trwałość · wykończenie · dyskrecja{% endif %}</small></div>\n    </article>\n\n    <article class=\"amx-standard__criterion\" data-amoura-reveal>\n      <div class=\"amx-standard__icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 48 48\"><circle cx=\"15\" cy=\"16\" r=\"6\"/><circle cx=\"33\" cy=\"32\" r=\"6\"/><path d=\"M20 19.5 28 28.5\"/><path d=\"M28 12h9v9\"/><path d=\"M37 12 27 22\"/><path d=\"M20 36h-9v-9\"/><path d=\"m11 36 10-10\"/></svg></div>\n      <div><h3>{% if request.locale.iso_code == 'en' %}Traceability & accountability{% else %}Pochodzenie i odpowiedzialność{% endif %}</h3><p>{% if request.locale.iso_code == 'en' %}We want traceability: who manufactured or supplied the product, what evidence supports the offer and who is responsible for warranty, complaints and support if something goes wrong.{% else %}Chcemy pełnej identyfikowalności: kto wyprodukował lub dostarczył produkt, jakie dowody stoją za ofertą i kto odpowiada za gwarancję, reklamację oraz wsparcie, gdy coś pójdzie nie tak.{% endif %}</p><small>{% if request.locale.iso_code == 'en' %}traceability · evidence · support{% else %}identyfikowalność · dowody · wsparcie{% endif %}</small></div>\n    </article>\n  </div>\n\n  <div class=\"amx-standard__proof\">\n    <div class=\"amx-standard__proof-head\">\n      <h3>{% if request.locale.iso_code == 'en' %}Three evidence states.{% else %}Trzy statusy dowodu.{% endif %}</h3>\n      <p class=\"amx-standard__proof-note\">{% if request.locale.iso_code == 'en' %}The rule is simple: the strength of the claim must never exceed the strength of the evidence behind it.{% else %}Zasada jest prosta: siła deklaracji nie może być większa niż siła dowodu, który za nią stoi.{% endif %}</p>\n    </div>\n    <div class=\"amx-standard__states\">\n      <div class=\"amx-standard__state\"><strong>{% if request.locale.iso_code == 'en' %}Verified{% else %}Zweryfikowane{% endif %}</strong><p>{% if request.locale.iso_code == 'en' %}Evidence reviewed and matched to the product or supplier documentation.{% else %}Dowód został sprawdzony i przypisany do produktu lub dokumentacji dostawcy.{% endif %}</p></div>\n      <div class=\"amx-standard__state\"><strong>{% if request.locale.iso_code == 'en' %}In validation{% else %}W walidacji{% endif %}</strong><p>{% if request.locale.iso_code == 'en' %}The claim is plausible, but documentation or verification is not yet sufficient for a final statement.{% else %}Deklaracja jest możliwa, ale dokumentacja lub weryfikacja nie wystarcza jeszcze do finalnego stwierdzenia.{% endif %}</p></div>\n      <div class=\"amx-standard__state\"><strong>{% if request.locale.iso_code == 'en' %}Not declared{% else %}Nie deklarujemy{% endif %}</strong><p>{% if request.locale.iso_code == 'en' %}If we cannot substantiate a claim, it does not appear as a product benefit.{% else %}Jeśli nie potrafimy poprzeć deklaracji dowodem, nie pokazujemy jej jako korzyści produktu.{% endif %}</p></div>\n    </div>\n  </div>\n\n  <div class=\"amx-standard__refs\">\n    <h4>{% if request.locale.iso_code == 'en' %}Reference framework{% else %}Ramy odniesienia{% endif %}</h4>\n    <div class=\"amx-standard__refs-copy\">\n      <p>{% if request.locale.iso_code == 'en' %}The applicable requirements depend on the product category. Our validation model is designed to map relevant evidence to the regulatory or technical framework that applies to a given product.{% else %}Zakres wymagań zależy od kategorii produktu. Model walidacji ma przypisywać właściwe dowody do regulacji lub norm technicznych, które rzeczywiście dotyczą danego wyrobu.{% endif %}</p>\n      <div class=\"amx-standard__badges\" aria-label=\"{% if request.locale.iso_code == 'en' %}Reference frameworks{% else %}Ramy odniesienia{% endif %}\">\n        <span class=\"amx-standard__badge\">GPSR</span>\n        <span class=\"amx-standard__badge\">REACH</span>\n        <span class=\"amx-standard__badge\">RoHS</span>\n        <span class=\"amx-standard__badge\">EMC</span>\n        <span class=\"amx-standard__badge\">ISO 3533:2021</span>\n      </div>\n      <p class=\"amx-standard__refs-note\">{% if request.locale.iso_code == 'en' %}These are validation references, not certification marks. Compliance is stated only after the relevant scope and evidence have been reviewed for the specific product.{% else %}To punkty odniesienia dla walidacji, a nie znaki certyfikacji. Zgodność deklarujemy wyłącznie po sprawdzeniu zakresu wymagań i dowodów właściwych dla konkretnego produktu.{% endif %}</p>\n    </div>\n  </div>\n</section>",
        "background_color": "#F4EDE7",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "expert_protocol": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n.amx-expert{position:relative;padding:82px clamp(34px,5.2vw,84px) 76px;background:#30272B;color:#F4EDE7;overflow:hidden}\n.amx-expert:after{content:\"\";position:absolute;right:-160px;bottom:-230px;width:500px;height:500px;border:1px solid rgba(244,237,231,.055);border-radius:50%;pointer-events:none}\n.amx-expert__head{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(320px,.85fr);gap:72px;align-items:end;margin-bottom:52px;position:relative;z-index:1}\n.amx-expert__eyebrow{display:flex;align-items:center;gap:14px;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:rgba(244,237,231,.58);margin-bottom:22px}\n.amx-expert__eyebrow:before{content:\"\";width:38px;height:1px;background:rgba(244,237,231,.3)}\n.amx-expert h2{font-family:Georgia,'Times New Roman',serif;font-size:clamp(40px,4.2vw,62px);line-height:.99;font-weight:400;color:#F4EDE7;margin:0;max-width:14ch;letter-spacing:-.03em;text-wrap:balance}\n.amx-expert__lead{font-size:16px;line-height:1.7;color:rgba(244,237,231,.74);margin:0;max-width:38rem}\n.amx-expert__roles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid rgba(244,237,231,.15);border-bottom:1px solid rgba(244,237,231,.15)}\n.amx-expert__role{padding:28px 28px 32px;border-right:1px solid rgba(244,237,231,.14);min-height:210px}\n.amx-expert__role:last-child{border-right:0}\n.amx-expert__role small{display:block;font-size:10px;letter-spacing:.15em;text-transform:uppercase;color:rgba(244,237,231,.45);margin-bottom:48px}\n.amx-expert__role strong{display:block;font-family:Georgia,'Times New Roman',serif;font-size:26px;line-height:1.05;font-weight:400;color:#F4EDE7;margin-bottom:12px}\n.amx-expert__role span{display:block;font-size:13px;line-height:1.62;color:rgba(244,237,231,.7)}\n.amx-expert__protocol{display:grid;grid-template-columns:minmax(0,.72fr) minmax(0,1.28fr);gap:56px;margin-top:42px;padding-top:30px;border-top:1px solid rgba(244,237,231,.12)}\n.amx-expert__protocol h3{font-family:Georgia,'Times New Roman',serif;font-size:28px;line-height:1.05;font-weight:400;color:#F4EDE7;margin:0;max-width:12ch}\n.amx-expert__protocol p{font-size:13px;line-height:1.72;color:rgba(244,237,231,.68);margin:0;max-width:52rem}\n@media(max-width:850px){.amx-expert__head,.amx-expert__protocol{grid-template-columns:1fr;gap:20px}.amx-expert__roles{grid-template-columns:1fr}.amx-expert__role{border-right:0;border-bottom:1px solid rgba(244,237,231,.14);min-height:0}.amx-expert__role:last-child{border-bottom:0}}\n@media(max-width:749px){.amx-expert{padding:56px 24px 58px}.amx-expert h2{font-size:clamp(38px,11vw,54px)}.amx-expert__role{padding:24px 0 26px}.amx-expert__role small{margin-bottom:26px}}\n</style>\n<section class=\"amx-expert\" data-amoura-mask>\n  <div class=\"amx-expert__head\">\n    <div>\n      <div class=\"amx-expert__eyebrow\">{% if request.locale.iso_code == 'en' %}How we build credible content{% else %}Jak budujemy wiarygodne treści{% endif %}</div>\n      <h2>{% if request.locale.iso_code == 'en' %}Expertise has a named owner.{% else %}Ekspertyza ma imię i zakres odpowiedzialności.{% endif %}</h2>\n    </div>\n    <p class=\"amx-expert__lead\">{% if request.locale.iso_code == 'en' %}Health-related content should be reviewed by professionals with a clearly defined scope of expertise. Editorial language must never turn education into diagnosis, treatment or an unsupported medical claim.{% else %}Treści dotyczące zdrowia powinny być przeglądane przez specjalistów z jasno określonym zakresem kompetencji. Język redakcyjny nie może zamieniać edukacji w diagnozę, terapię ani niepotwierdzone twierdzenie medyczne.{% endif %}</p>\n  </div>\n\n  <div class=\"amx-expert__roles\">\n    <article class=\"amx-expert__role\" data-amoura-reveal><small>{% if request.locale.iso_code == 'en' %}Clinical context{% else %}Kontekst kliniczny{% endif %}</small><strong>{% if request.locale.iso_code == 'en' %}Gynaecology{% else %}Ginekologia{% endif %}</strong><span>{% if request.locale.iso_code == 'en' %}menopause, intimate health, symptoms, contraindications and when consultation is appropriate{% else %}menopauza, zdrowie intymne, objawy, przeciwwskazania i moment, w którym właściwa jest konsultacja lekarska{% endif %}</span></article>\n    <article class=\"amx-expert__role\" data-amoura-reveal><small>{% if request.locale.iso_code == 'en' %}Psychosexual context{% else %}Kontekst psychoseksualny{% endif %}</small><strong>{% if request.locale.iso_code == 'en' %}Sexology / psychology{% else %}Seksuologia / psychologia{% endif %}</strong><span>{% if request.locale.iso_code == 'en' %}desire, communication, relationships, shame reduction and emotional wellbeing{% else %}pożądanie, komunikacja, relacje, redukcja wstydu i dobrostan emocjonalny{% endif %}</span></article>\n    <article class=\"amx-expert__role\" data-amoura-reveal><small>{% if request.locale.iso_code == 'en' %}Functional context{% else %}Kontekst funkcjonalny{% endif %}</small><strong>{% if request.locale.iso_code == 'en' %}Pelvic health{% else %}Zdrowie dna miednicy{% endif %}</strong><span>{% if request.locale.iso_code == 'en' %}comfort, body function, pelvic-floor considerations and safe use within professional scope{% else %}komfort, funkcja ciała, zagadnienia dna miednicy i bezpieczne użycie w granicach kompetencji specjalisty{% endif %}</span></article>\n  </div>\n\n  <div class=\"amx-expert__protocol\">\n    <h3>{% if request.locale.iso_code == 'en' %}Editorial review protocol{% else %}Protokół review treści{% endif %}</h3>\n    <p>{% if request.locale.iso_code == 'en' %}For each health-related article or claim we want a traceable source, a named reviewer where specialist review is needed, a review date and a clear distinction between education, product information and medical advice. If a statement cannot be supported by evidence or falls outside the reviewer’s scope, we remove or qualify it rather than strengthen the wording.{% else %}Dla każdej treści zdrowotnej lub deklaracji chcemy mieć możliwe do prześledzenia źródło, imiennego recenzenta tam, gdzie potrzebny jest review specjalistyczny, datę przeglądu oraz jasne rozróżnienie między edukacją, informacją produktową a poradą medyczną. Jeśli twierdzenia nie da się poprzeć dowodem albo wykracza poza kompetencje recenzenta, ograniczamy je lub usuwamy zamiast wzmacniać język.{% endif %}</p>\n  </div>\n</section>",
        "background_color": "#30272B",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
  },
