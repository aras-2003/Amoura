    "product_story": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n.amv2-pdp-support{padding:56px 0 72px;border-top:1px solid rgba(74,16,42,.14)}\n.amv2-pdp-support__note{display:grid;grid-template-columns:.7fr 1.3fr;gap:46px;padding:22px 0 34px}\n.amv2-pdp-support__note small{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8B6675}\n.amv2-pdp-support__note p{font-size:15px;line-height:1.6;color:#3E3337;margin:0;max-width:46rem}\n.amv2-pdp-support__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(74,16,42,.16)}\n.amv2-pdp-support__item{background:#F4EDE7;padding:26px;min-height:170px}\n.amv2-pdp-support__item h3{font-family:Georgia,'Times New Roman',serif;font-size:21px;font-weight:400;color:#4A102A;margin:0 0 10px}\n.amv2-pdp-support__item p{font-size:14px;line-height:1.55;color:#3E3337;margin:0}\n@media(max-width:749px){.amv2-pdp-support__note,.amv2-pdp-support__grid{grid-template-columns:1fr}.amv2-pdp-support__note{gap:12px}.amv2-pdp-support__item{min-height:0}}\n</style>\n<section class=\"amv2-pdp-support\">\n{% if request.locale.iso_code == 'en' %}\n<div class=\"amv2-pdp-support__note\"><small>Concept product</small><p>This product is part of the Amoura prototype. Price, visuals and specifications are test content used to validate the experience and are not a final commercial offer.</p></div>\n<div class=\"amv2-pdp-support__grid\"><div class=\"amv2-pdp-support__item\"><h3>Take your time</h3><p>You do not need to use everything at once. Begin with the simplest version of the ritual and notice what feels comfortable.</p></div><div class=\"amv2-pdp-support__item\"><h3>Comfort matters</h3><p>The product should fit the body and the moment, not demand a performance.</p></div><div class=\"amv2-pdp-support__item\"><h3>What we look for</h3><p>A clear purpose, good materials and enough simplicity to make the product easy to live with.</p></div></div>\n{% else %}\n<div class=\"amv2-pdp-support__note\"><small>Produkt koncepcyjny</small><p>Ten produkt jest częścią prototypu Amoura. Cena, wizualizacja i parametry służą walidacji doświadczenia i nie stanowią jeszcze finalnej oferty handlowej.</p></div>\n<div class=\"amv2-pdp-support__grid\"><div class=\"amv2-pdp-support__item\"><h3>Daj sobie czas</h3><p>Nie musisz robić wszystkiego od razu. Zacznij od najprostszej wersji rytuału i sprawdź, co jest dla Ciebie komfortowe.</p></div><div class=\"amv2-pdp-support__item\"><h3>Komfort ma znaczenie</h3><p>Produkt ma pasować do ciała i chwili, nie stawiać przed Tobą zadania.</p></div><div class=\"amv2-pdp-support__item\"><h3>Na co zwracamy uwagę</h3><p>Jasna funkcja, dobre materiały i prostota, dzięki której z produktu naprawdę chce się korzystać.</p></div></div>\n{% endif %}\n</section>",
        "background_color": "#F4EDE7",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "knowledge_bridge": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n.amv3-kbridge{display:grid;grid-template-columns:1.05fr .95fr;min-height:560px;background:#30272B;color:#F4EDE7;overflow:hidden}\n.amv3-kbridge__media{min-height:480px;overflow:hidden;background:#3B241E}\n.amv3-kbridge__media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .8s cubic-bezier(.2,.7,.2,1)}\n.amv3-kbridge:hover .amv3-kbridge__media img{transform:scale(1.018)}\n.amv3-kbridge__copy{padding:clamp(36px,5vw,70px);display:flex;flex-direction:column;justify-content:center}\n.amv3-kbridge__eyebrow{font-size:11px;letter-spacing:.16em;text-transform:uppercase;opacity:.68;margin:0 0 16px}\n.amv3-kbridge h2{font-family:Georgia,'Times New Roman',serif;font-size:clamp(36px,4.7vw,60px);line-height:.98;font-weight:400;color:#F4EDE7;margin:0 0 22px}\n.amv3-kbridge p{font-size:15px;line-height:1.65;opacity:.88;margin:0 0 24px;max-width:35rem}\n.amv3-kbridge a{align-self:flex-start;color:#F4EDE7;text-decoration:none;border-bottom:1px solid rgba(244,237,231,.75);padding-bottom:3px}\n@media(max-width:749px){.amv3-kbridge{grid-template-columns:1fr}.amv3-kbridge__media{min-height:330px}}\n</style>\n{% assign related_article = nil %}\n{% for a in blogs['wiedza'].articles %}\n  {% assign match = false %}\n  {% for tag in a.tags %}\n    {% if product.tags contains tag %}{% assign match = true %}{% endif %}\n  {% endfor %}\n  {% if match and related_article == nil %}{% assign related_article = a %}{% endif %}\n{% endfor %}\n{% if related_article %}\n  {% assign editorial_image = 'amoura-v2-editorial-lifestyle.png' %}\n  {% if related_article.tags contains 'intimacy' %}{% assign editorial_image = 'amoura-v3-intimacy-editorial.png' %}{% endif %}\n  {% if related_article.tags contains 'ritual' and related_article.tags contains 'touch' %}{% assign editorial_image = 'amoura-v3-ritual-editorial.png' %}{% endif %}\n  <section class=\"amv3-kbridge\">\n    <div class=\"amv3-kbridge__media\"><img src=\"{{ editorial_image | file_url }}\" alt=\"{{ related_article.title | escape }}\"></div>\n    <div class=\"amv3-kbridge__copy\">\n      <p class=\"amv3-kbridge__eyebrow\">{% if request.locale.iso_code == 'en' %}Read in context{% else %}Doczytaj w kontekście{% endif %}</p>\n      <h2>{{ related_article.title }}</h2>\n      <p>{{ related_article.excerpt_or_content | strip_html | truncate: 210 }}</p>\n      <a href=\"{{ related_article.url }}\">{% if request.locale.iso_code == 'en' %}Read before you choose →{% else %}Przeczytaj przed wyborem →{% endif %}</a>\n    </div>\n  </section>\n{% endif %}",
        "background_color": "#30272B",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "soft_editorial": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{% if product.handle == 'soft-ritual-massager' %}\n<style>\n.amx-soft{padding:80px 0 96px}\n.amx-soft__kicker{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#8B6675;margin-bottom:18px}\n.amx-soft__title{font-family:Georgia,'Times New Roman',serif;font-size:clamp(42px,5.5vw,72px);line-height:.94;font-weight:400;color:#4A102A;margin:0 0 46px;max-width:11ch}\n.amx-soft__story{display:grid;grid-template-columns:1.05fr .95fr;gap:58px;align-items:start}\n.amx-soft__media{position:sticky;top:120px;overflow:hidden;background:#E8DDD6}\n.amx-soft__media img{width:100%;display:block}\n.amx-soft__copy section{min-height:52vh;padding:34px 0;border-top:1px solid rgba(74,16,42,.16);display:flex;flex-direction:column;justify-content:center}\n.amx-soft__copy small{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#8B6675;margin-bottom:12px}\n.amx-soft__copy h3{font-family:Georgia,'Times New Roman',serif;font-size:clamp(30px,3.7vw,48px);line-height:1;font-weight:400;color:#4A102A;margin:0 0 14px}\n.amx-soft__copy p{font-size:15px;line-height:1.65;color:#3E3337;margin:0;max-width:33rem}\n.amx-soft__copy a{align-self:flex-start;margin-top:18px;color:#4A102A;text-decoration:none;border-bottom:1px solid #4A102A;padding-bottom:3px}\n@media(max-width:850px){.amx-soft__story{grid-template-columns:1fr}.amx-soft__media{position:relative;top:auto}.amx-soft__copy section{min-height:auto;padding:40px 0}}\n</style>\n<section class=\"amx-soft\">\n<p class=\"amx-soft__kicker\" data-amoura-reveal>{% if request.locale.iso_code == 'en' %}Soft Ritual, considered slowly{% else %}Soft Ritual, bez pośpiechu{% endif %}</p>\n<h2 class=\"amx-soft__title\" data-amoura-reveal>{% if request.locale.iso_code == 'en' %}A discreet object. A very personal use.{% else %}Dyskretny przedmiot. Bardzo osobisty sposób użycia.{% endif %}</h2>\n<div class=\"amx-soft__story\">\n  <div class=\"amx-soft__media\" data-amoura-mask><img data-amoura-parallax src=\"{{ product.featured_image | image_url: width: 1500 }}\" alt=\"{{ product.title | escape }}\"></div>\n  <div class=\"amx-soft__copy\">\n    <section data-amoura-reveal><small>01 · {% if request.locale.iso_code == 'en' %}for whom{% else %}dla kogo{% endif %}</small><h3>{% if request.locale.iso_code == 'en' %}For quiet curiosity.{% else %}Dla spokojnej ciekawości.{% endif %}</h3><p>{% if request.locale.iso_code == 'en' %}A discreet next step when you want to explore pleasure without turning it into another performance target.{% else %}Dyskretny kolejny krok, kiedy chcesz eksplorować przyjemność bez zamieniania jej w kolejny cel do osiągnięcia.{% endif %}</p></section>\n    <section data-amoura-reveal><small>02 · {% if request.locale.iso_code == 'en' %}how to begin{% else %}jak zacząć{% endif %}</small><h3>{% if request.locale.iso_code == 'en' %}Start where it feels natural.{% else %}Zacznij tam, gdzie czujesz się naturalnie.{% endif %}</h3><p>{% if request.locale.iso_code == 'en' %}Give yourself time, privacy and a setting in which nothing needs to happen. A good first experience is the one that feels natural, not impressive.{% else %}Daj sobie czas, prywatność i warunki, w których nic nie musi się wydarzyć. Dobre pierwsze doświadczenie to takie, które jest naturalne – nie spektakularne.{% endif %}</p></section>\n    <section data-amoura-reveal><small>03 · {% if request.locale.iso_code == 'en' %}read in context{% else %}doczytaj w kontekście{% endif %}</small><h3>{% if request.locale.iso_code == 'en' %}Pleasure changes. That can be a good thing.{% else %}Przyjemność się zmienia. I to może być dobra wiadomość.{% endif %}</h3><p>{% if request.locale.iso_code == 'en' %}Our guide on intimacy after 35 puts comfort, communication and changing needs before technique.{% else %}W materiale o bliskości po 35. stawiamy komfort, komunikację i zmieniające się potrzeby przed techniką.{% endif %}</p><a href=\"{% if request.locale.iso_code == 'en' %}/en/blogs/journal/intimacy-after-35{% else %}/blogs/wiedza/bliskosc-po-35{% endif %}\">{% if request.locale.iso_code == 'en' %}Read the guide →{% else %}Przeczytaj materiał →{% endif %}</a></section>\n  </div>\n</div>\n</section>\n{% endif %}",
