    "knowledge_bridge": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n.amv3-kbridge{display:grid;grid-template-columns:1.05fr .95fr;min-height:420px;background:#30272B;color:#F4EDE7;overflow:hidden}.amv3-kbridge__media{min-height:360px;overflow:hidden}.amv3-kbridge__media img{width:100%;height:100%;object-fit:cover}.amv3-kbridge__copy{padding:42px;display:flex;flex-direction:column;justify-content:center}.amv3-kbridge small{font-size:12px;letter-spacing:.14em;text-transform:uppercase;opacity:.7}.amv3-kbridge h2{font-family:Georgia,'Times New Roman',serif;font-size:clamp(30px,4vw,48px);font-weight:400;line-height:1;color:#F4EDE7;margin:12px 0 14px}.amv3-kbridge p{font-size:14px;line-height:1.58;opacity:.86;margin:0 0 18px}.amv3-kbridge a{color:#F4EDE7;text-decoration:none;border-bottom:1px solid rgba(244,237,231,.7);align-self:flex-start;padding-bottom:3px}\n@media(max-width:749px){.amv3-kbridge{grid-template-columns:1fr;min-height:0}.amv3-kbridge__media{min-height:260px}.amv3-kbridge__copy{padding:30px 22px}}\n</style>\n<section class=\"amv3-kbridge\"><div class=\"amv3-kbridge__media\"><img src=\"{{ 'amoura-v2-editorial-lifestyle.png' | file_url }}\" alt=\"\"></div><div class=\"amv3-kbridge__copy\"><small>{% if request.locale.iso_code == 'en' %}Context{% else %}Kontekst{% endif %}</small><h2>{% if request.locale.iso_code == 'en' %}First product? Start with the criteria.{% else %}Pierwszy produkt? Zacznij od kryteriów.{% endif %}</h2><p>{% if request.locale.iso_code == 'en' %}A short guide to material, intensity, comfort and what is actually worth looking for.{% else %}Krótki przewodnik po materiale, intensywności, komforcie i tym, czego naprawdę warto szukać.{% endif %}</p><a href=\"{% if request.locale.iso_code == 'en' %}/en/blogs/journal/how-to-choose-your-first-intimate-product{% else %}/blogs/wiedza/jak-wybrac-pierwszy-produkt-intymny{% endif %}\">{% if request.locale.iso_code == 'en' %}Read the guide →{% else %}Przeczytaj przewodnik →{% endif %}</a></div></section>",
        "background_color": "#30272B",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "pairing": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n.amx-pair{padding:50px 0 58px;background:#EFE5DF}.amx-pair__head{display:grid;grid-template-columns:.7fr 1.3fr;gap:56px;margin-bottom:28px}.amx-pair small{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#744D5E}.amx-pair h2{font-family:Georgia,'Times New Roman',serif;font-size:clamp(32px,4vw,50px);font-weight:400;line-height:1;color:#4A102A;margin:0 0 12px}.amx-pair p{font-size:14px;line-height:1.6;color:#3E3337;margin:0;max-width:42rem}\n.amx-pair__grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.amx-pair__item{display:grid;grid-template-columns:150px 1fr;background:#F4EDE7;text-decoration:none;color:#4A102A;min-height:180px}.amx-pair__media{overflow:hidden;background:#E6D9D2}.amx-pair__media img{width:100%;height:100%;object-fit:cover}.amx-pair__copy{padding:22px}.amx-pair__copy small{font-size:9px}.amx-pair__copy h3{font-family:Georgia,'Times New Roman',serif;font-size:22px;font-weight:400;margin:22px 0 8px}.amx-pair__copy span{font-size:13px;color:#3E3337}\n@media(max-width:780px){.amx-pair__head,.amx-pair__grid{grid-template-columns:1fr}.amx-pair__item{grid-template-columns:120px 1fr}}\n</style>\n{% assign pair1 = nil %}{% assign pair2 = nil %}\n{% if product.tags contains 'core' or product.tags contains 'intimacy' %}\n  {% assign pair1 = all_products['perennial-lubricant-ha'] %}{% assign pair2 = all_products['perennial-calm-ritual-candle'] %}\n{% elsif product.tags contains 'comfort' or product.tags contains 'hormonal-change' %}\n  {% assign pair1 = all_products['soft-ritual-massager'] %}{% assign pair2 = all_products['renaissance-body-oil'] %}\n{% else %}\n  {% assign pair1 = all_products['perennial-ritual-oil'] %}{% assign pair2 = all_products['perennial-warm-body-stone'] %}\n{% endif %}\n<section class=\"amx-pair\"><div class=\"amx-pair__head\"><small>{% if request.locale.iso_code == 'en' %}Complete only if useful{% else %}Dobierz tylko, jeśli ma sens{% endif %}</small><div><h2>{% if request.locale.iso_code == 'en' %}Two adjacent choices, not an automatic upsell.{% else %}Dwie sąsiednie opcje, nie automatyczny upsell.{% endif %}</h2><p>{% if request.locale.iso_code == 'en' %}A larger basket is not the goal. These products are shown because they can support the same moment from a different angle.{% else %}Większy koszyk nie jest celem samym w sobie. Te produkty pojawiają się dlatego, że mogą wesprzeć ten sam moment z innej strony.{% endif %}</p></div></div>\n<div class=\"amx-pair__grid\">\n{% if pair1 and pair1.id != product.id %}<a class=\"amx-pair__item\" data-amoura-track=\"pdp_pair_1\" href=\"{{ pair1.url }}\"><div class=\"amx-pair__media\"><img src=\"{{ pair1.featured_image | image_url: width: 500 }}\" alt=\"{{ pair1.title | escape }}\"></div><div class=\"amx-pair__copy\"><small>{% if request.locale.iso_code == 'en' %}Consider alongside{% else %}Rozważ razem{% endif %}</small><h3>{{ pair1.title }}</h3><span>{{ pair1.price | money }}</span></div></a>{% endif %}\n{% if pair2 and pair2.id != product.id %}<a class=\"amx-pair__item\" data-amoura-track=\"pdp_pair_2\" href=\"{{ pair2.url }}\"><div class=\"amx-pair__media\"><img src=\"{{ pair2.featured_image | image_url: width: 500 }}\" alt=\"{{ pair2.title | escape }}\"></div><div class=\"amx-pair__copy\"><small>{% if request.locale.iso_code == 'en' %}Consider alongside{% else %}Rozważ razem{% endif %}</small><h3>{{ pair2.title }}</h3><span>{{ pair2.price | money }}</span></div></a>{% endif %}\n</div></section>",
        "background_color": "#EFE5DF",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
