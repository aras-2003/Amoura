    "decision_panel": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n.amx-decision{padding:0 0 42px}.amx-decision__bar{display:grid;grid-template-columns:repeat(6,1fr);gap:1px;background:rgba(74,16,42,.14);border:1px solid rgba(74,16,42,.14)}\n.amx-decision__item{background:#F4EDE7;padding:18px 16px}.amx-decision__item small{display:block;font-size:10px;letter-spacing:.13em;text-transform:uppercase;color:#744D5E;margin-bottom:8px}.amx-decision__item strong{display:block;font-size:14px;line-height:1.35;color:#4A102A;font-weight:600}\n@media(max-width:900px){.amx-decision__bar{grid-template-columns:repeat(3,1fr)}}@media(max-width:560px){.amx-decision{padding-bottom:32px}.amx-decision__bar{grid-template-columns:repeat(2,1fr)}.amx-decision__item{padding:15px 14px}}\n</style>\n{% assign entry = 'Łagodny start' %}\n{% if product.handle contains 'massager' %}{% assign entry = 'Eksploracja' %}{% endif %}\n{% if product.handle contains 'lubricant' %}{% assign entry = 'Komfort' %}{% endif %}\n{% if product.handle contains 'set' or product.handle contains 'duo' or product.handle contains 'starter' %}{% assign entry = 'Zestaw' %}{% endif %}\n<section class=\"amx-decision\"><div class=\"amx-decision__bar\">\n<div class=\"amx-decision__item\"><small>{% if request.locale.iso_code == 'en' %}Starting point{% else %}Punkt wejścia{% endif %}</small><strong>{% if request.locale.iso_code == 'en' %}{% if entry == 'Łagodny start' %}Gentle start{% elsif entry == 'Eksploracja' %}Exploration{% elsif entry == 'Komfort' %}Comfort{% else %}Set{% endif %}{% else %}{{ entry }}{% endif %}</strong></div>\n<div class=\"amx-decision__item\"><small>{% if request.locale.iso_code == 'en' %}Role{% else %}Rola{% endif %}</small><strong>{% if request.locale.iso_code == 'en' %}A clear place in the routine{% else %}Jasne miejsce w rutynie{% endif %}</strong></div>\n<div class=\"amx-decision__item\"><small>{% if request.locale.iso_code == 'en' %}Intensity{% else %}Intensywność{% endif %}</small><strong>{% if request.locale.iso_code == 'en' %}Check final specification{% else %}Sprawdź finalną specyfikację{% endif %}</strong></div>\n<div class=\"amx-decision__item\"><small>{% if request.locale.iso_code == 'en' %}Discretion{% else %}Dyskrecja{% endif %}</small><strong>{% if request.locale.iso_code == 'en' %}In validation{% else %}W walidacji{% endif %}</strong></div>\n<div class=\"amx-decision__item\"><small>{% if request.locale.iso_code == 'en' %}Material{% else %}Materiał{% endif %}</small><strong>{% if request.locale.iso_code == 'en' %}Evidence required{% else %}Do potwierdzenia{% endif %}</strong></div>\n<div class=\"amx-decision__item\"><small>{% if request.locale.iso_code == 'en' %}Amoura status{% else %}Status Amoura{% endif %}</small><strong>{% if request.locale.iso_code == 'en' %}In validation{% else %}W walidacji{% endif %}</strong></div>\n</div></section>",
