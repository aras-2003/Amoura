ntro--no-media{% endunless %}\">\n  <div class=\"amoura-collection-intro__copy\">\n    {% if request.locale.iso_code == 'en' %}\n      <p class=\"amoura-collection-intro__kicker\">Amoura · edit</p>\n    {% else %}\n      <p class=\"amoura-collection-intro__kicker\">Amoura · selekcja</p>\n    {% endif %}\n    <h1>{{ collection.title }}</h1>\n    {% if collection.description != blank %}<div class=\"amoura-collection-intro__desc\">{{ collection.description | strip_html | truncatewords: 30 }}</div>{% endif %}\n    {% if request.locale.iso_code == 'en' %}\n      <div class=\"amoura-collection-intro__note\">Chosen around real moments and needs, not technical product categories.</div>\n    {% else %}\n      <div class=\"amoura-collection-intro__note\">Wybieramy według realnych potrzeb i momentów życia, nie technicznych kategorii.</div>\n    {% endif %}\n  </div>\n  {% if collection.image %}<div class=\"amoura-collection-intro__media\">{{ collection.image | image_url: width: 1800 | image_tag: loading: 'eager', alt: collection.title }}</div>{% endif %}\n</div>",
