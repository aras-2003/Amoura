<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
  dir="{{ request.locale.direction | default: 'ltr' }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {%- render 'view-transition-opt-in' -%}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'card-hover-effect-styles' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
    <style id="amoura-motion-system">
  @view-transition { navigation:auto; }
  ::view-transition-old(root){animation:amoura-out .16s ease both}
  ::view-transition-new(root){animation:amoura-in .30s cubic-bezier(.2,.7,.2,1) both}
  @keyframes amoura-out{to{opacity:0}}
  @keyframes amoura-in{from{opacity:0}to{opacity:1}}
  h1,h2,.h1,.h2{font-family:Georgia,'Times New Roman',serif;letter-spacing:-.025em}
  [data-amoura-reveal],[data-amoura-mask]{opacity:1;transform:none;clip-path:none}
  html.amoura-motion-ready [data-amoura-reveal]{opacity:0;transform:translateY(16px);transition:opacity .72s cubic-bezier(.2,.7,.2,1),transform .72s cubic-bezier(.2,.7,.2,1)}
  html.amoura-motion-ready [data-amoura-reveal].is-visible{opacity:1;transform:none}
  html.amoura-motion-ready [data-amoura-mask]{clip-path:inset(0 0 100% 0);transition:clip-path .9s cubic-bezier(.2,.7,.2,1)}
  html.amoura-motion-ready [data-amoura-mask].is-visible{clip-path:inset(0)}
  [data-amoura-parallax]{will-change:transform;transform:scale(1.02)}
  /* Amoura layout guardrails */
  .content-for-layout [class*="amx-"],
  .content-for-layout [class*="amv2-"],
  .content-for-layout [class*="amv3-"]{min-width:0}
  .content-for-layout [class*="amx-"] *,
  .content-for-layout [class*="amv2-"] *,
  .content-for-layout [class*="amv3-"] *{box-sizing:border-box;min-width:0}
  .content-for-layout [class*="amx-"] h1,
  .content-for-layout [class*="amv2-"] h1,
  .content-for-layout [class*="amv3-"] h1{line-height:.96;overflow-wrap:normal;text-wrap:balance}
  .content-for-layout [class*="amx-"] h2,
  .content-for-layout [class*="amv2-"] h2,
  .content-for-layout [class*="amv3-"] h2,
  .content-for-layout [class*="amx-"] h3,
  .content-for-layout [class*="amv2-"] h3,
  .content-for-layout [class*="amv3-"] h3{line-height:1.02;text-wrap:balance}
  .content-for-layout [class*="amx-"] p,
  .content-for-layout [class*="amv2-"] p,
  .content-for-layout [class*="amv3-"] p{overflow-wrap:break-word}
  .amx-manifesto__inner,
  .amx-about-break__inner{width:min(1180px,calc(100% - 64px));margin-inline:auto}
  .amv3-kbridge__copy,
  .amv2-knowledge__body{padding-inline:max(32px,5vw)}
  .amv3-inline-product__copy,
  .amv3-feed__article,
  .amx-club__questions{padding-inline:max(28px,4vw)}
  .amoura-collection-intro__copy{padding-inline:max(30px,5vw)}
  @media(max-width:900px){
    .content-for-layout [class*="amx-"] h1,
    .content-for-layout [class*="amv2-"] h1,
    .content-for-layout [class*="amv3-"] h1{line-height:1}
    .amx-manifesto__inner,
    .amx-about-break__inner{width:calc(100% - 32px)}
    .amv3-kbridge__copy,
    .amv2-knowledge__body,
    .amv3-inline-product__copy,
    .amv3-feed__article,
    .amx-club__questions,
    .amoura-collection-intro__copy{padding-inline:22px}
  }
  /* Amoura readability system */
  :root{--amoura-max:1180px;--amoura-gutter:clamp(22px,4vw,64px);--amoura-copy:46rem}
  .amx-finder__inner,
  .amx-expert__grid,
  .amx-pdp-private__inner{width:min(var(--amoura-max),calc(100% - (var(--amoura-gutter) * 2)));margin-inline:auto}
  .amx-why__head,.amx-standard__intro,.amx-trust__head,.amx-founding__intro,.amx-pair__head,.amx-voice__inner,
  .amoura-collection-story__grid,.amoura-collection-guide__row{align-items:start}
  .content-for-layout [class*="amx-"] p,
  .content-for-layout [class*="amv2-"] p,
  .content-for-layout [class*="amv3-"] p{max-width:var(--amoura-copy)}
  .amx-why__grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  .amx-standard__grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  .amx-founding__grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  .amx-why__item,.amx-standard__item,.amx-founding__item{min-height:0!important;padding:clamp(24px,3vw,38px)!important}
  .amx-why__item h3,.amx-standard__item h3,.amx-founding__item strong{margin-top:18px!important}
  .amx-path,.amx-trust__card,.amx-pair__copy{overflow-wrap:anywhere}
  .amv3-feed__article h2{font-size:clamp(30px,3.4vw,48px)!important;max-width:15ch!important}
  .amv3-article-copy{max-width:720px!important}
  .amv3-article-copy p,.amv3-article-copy li{font-size:17px;line-height:1.78}
  .amoura-collection-story__copy{max-width:720px!important}
  @media(max-width:900px){
    :root{--amoura-gutter:22px}
    .amx-why__grid,.amx-standard__grid,.amx-founding__grid{grid-template-columns:1fr!important}
    .amx-paths__grid{grid-template-columns:1fr!important}
    .amx-path{min-height:0!important;padding:30px 24px!important}
    .amx-path h3{margin:54px 0 14px!important;max-width:14ch!important}
    .amx-trust__status{grid-template-columns:1fr!important}
    .amx-pair__grid{grid-template-columns:1fr!important}
    .amx-expert__roles{grid-template-columns:1fr!important}
  }
  @media(max-width:749px){
    .content-for-layout [class*="amx-"] h1,
    .content-for-layout [class*="amv2-"] h1,
    .content-for-layout [class*="amv3-"] h1{font-size:clamp(38px,11vw,50px)!important;line-height:.98!important;letter-spacing:-.035em!important}
    .content-for-layout [class*="amx-"] h2,
    .content-for-layout [class*="amv2-"] h2,
    .content-for-layout [class*="amv3-"] h2{font-size:clamp(31px,9vw,42px)!important;line-height:1.02!important;letter-spacing:-.025em!important}
    .content-for-layout [class*="amx-"] p,
    .content-for-layout [class*="amv2-"] p,
    .content-for-layout [class*="amv3-"] p{font-size:15px;line-height:1.68}
    .amv3-article-copy{padding-inline:2px}
    .amv3-article-copy p,.amv3-article-copy li{font-size:16px;line-height:1.75}
    .amv3-inline-product__copy,.amv2-knowledge__body,.amv3-kbridge__copy{padding:30px 22px!important}
    .amv3-feed__article{padding:30px 24px!important;min-height:0!important}
    .amv3-feed__product{min-height:300px!important}
    .amv3-feed__product div{left:22px!important;right:22px!important;bottom:22px!important}
    .amoura-collection-intro__copy{padding:34px 24px!important}
    .amoura-collection-story,.amoura-collection-guide{padding-top:46px!important;padding-bottom:54px!important}
    .amx-finder,.amx-expert,.amx-pdp-private{padding-top:52px!important;padding-bottom:58px!important}
    /* Mobile UX tuning from rendered-device audit */
    .content-for-layout[data-template="index"] .hero{--hero-min-height:68svh!important}
    .content-for-layout[data-template="index"] .hero__container{padding-block-start:44px!important;padding-block-end:44px!important}
    .content-for-layout[data-template="index"] .hero__content-wrapper{align-items:flex-start!important;text-align:left!important;padding-inline:24px!important;gap:14px!important}
    .content-for-layout[data-template="index"] .hero__content-wrapper h1{font-family:Georgia,'Times New Roman',serif!important;font-size:clamp(40px,11vw,48px)!important;line-height:.96!important;letter-spacing:-.035em!important;max-width:9ch;margin:0}
    .content-for-layout[data-template="index"] .hero__content-wrapper p{font-size:18px!important;line-height:1.42!important;font-weight:400!important;max-width:30ch!important;margin:0}
    .amx-paths{padding:48px 0 62px!important}
    .amx-paths__head{gap:20px!important;margin-bottom:26px!important}
    .amx-paths h2{font-size:38px!important;max-width:11ch!important}
    .amx-path{padding:26px 22px!important}
    .amx-path h3{font-size:30px!important;line-height:1.02!important;margin:32px 0 12px!important;max-width:12ch!important}
    .amv2-products{padding:54px 0 66px!important}
    .amv2-products__head{margin-bottom:24px!important}
    .amv2-product h3{font-size:18px!important;line-height:1.14!important;letter-spacing:-.01em!important}
    .amv2-knowledge__body{padding:34px 24px 42px!important}
    .amv2-knowledge h2{font-size:34px!important;line-height:1.02!important;max-width:14ch!important;margin-bottom:22px!important}
    .amv2-knowledge__item strong{font-size:18px!important;line-height:1.22!important}
    .amx-about-manifesto{padding:48px 0 58px!important}
    .amx-about-manifesto__lead{margin-bottom:30px!important}
    .amx-about-manifesto__lead h2{font-size:36px!important;max-width:12ch!important}
    .amx-about-manifesto__row{padding:22px 0!important}
    .amx-about-manifesto__row h3{font-size:27px!important;line-height:1.06!important}
    .amx-standard{padding:58px 0 68px!important}
    .amx-standard h2{font-size:36px!important;max-width:13ch!important}
    .amx-standard__item{padding:22px!important}
    .amx-standard__item h3{font-size:24px!important;margin:16px 0 8px!important}
    .amx-standard__proof h3{font-size:32px!important;line-height:1.04!important}
    .amoura-collection-guide__content h2{font-size:34px!important;line-height:1.04!important}
    .amoura-collection-guide__content p{font-size:16px!important;line-height:1.62!important}
  }
  /* Amoura wide-screen scaling: keep the site editorial rather than tiny on
     ultra-wide viewports or when a desktop browser is zoomed out. */
  @media(min-width:1600px){
    body.page-width-normal{
      --normal-page-width:min(1680px,88vw);
    }
  }
  @media(min-width:2200px){
    body.page-width-normal{
      --normal-page-width:min(1840px,84vw);
    }
  }
  /* Global Amoura mobile ergonomics */
  @media(max-width:749px){
    .content-for-layout .button,
    .content-for-layout button[type="submit"],
    .content-for-layout input[type="submit"]{min-height:44px}
    .content-for-layout [class*="amx-"] a:not(.amv2-product):not(.amv3-feed__article):not(.amv3-feed__product),
    .content-for-layout [class*="amv2-"] a:not(.amv2-product):not(.amv3-feed__article):not(.amv3-feed__product),
    .content-for-layout [class*="amv3-"] a:not(.amv2-product):not(.amv3-feed__article):not(.amv3-feed__product){padding-block:6px}
    .content-for-layout [class*="amx-"] small,
    .content-for-layout [class*="amv2-"] small,
    .content-for-layout [class*="amv3-"] small{font-size:12px!important}
    #header-group .header__row{min-height:56px}
  }
  /* Rich product copy */
  .product-information .rte h3,.product-details .rte h3{font-family:Georgia,'Times New Roman',serif;font-size:1.45rem;line-height:1.1;font-weight:400;color:#4A102A;margin:30px 0 10px}
  .product-information .rte p,.product-information .rte li,.product-details .rte p,.product-details .rte li{line-height:1.62}
  .product-information .rte ul,.product-details .rte ul{padding-left:1.2rem;margin:12px 0 22px}
  @media (prefers-reduced-motion:reduce){
    ::view-transition-old(root),::view-transition-new(root){animation-duration:.01s!important}
    [data-amoura-reveal],[data-amoura-mask]{opacity:1!important;transform:none!important;clip-path:none!important;transition:none!important}
    [data-amoura-parallax]{transform:none!important}
  }
/* Amoura final UX simplification pass */
  .amoura-footer-links{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:26px;margin-top:8px}
  .amoura-footer-links>div{display:flex;flex-direction:column;gap:8px}
  .amoura-footer-links strong{color:#F4EDE7;font-weight:600;margin-bottom:4px}
  .amoura-footer-links a{color:#F4EDE7;text-decoration:none;opacity:.86}
  .amoura-footer-links a:hover{opacity:1;text-decoration:underline}
  @media(max-width:749px){
    #header-group .header-announcements{display:none!important}
    #header-group .header{min-height:58px!important}
    .content-for-layout a.button,.content-for-layout button,.amx-founding__form button{min-height:44px}
    .content-for-layout [class*="__more"],.content-for-layout [class*="__all"],.content-for-layout [class*="__link"]{padding-block:8px}
    .content-for-layout [class*="eyebrow"],.content-for-layout [class*="__label"],.content-for-layout [class*="__meta"],.content-for-layout small{font-size:max(12px,.75rem)}
    .amoura-footer-links{grid-template-columns:1fr 1fr;gap:24px 18px}
  }
</style>
<script>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('amoura-motion-ready');
  }
</script>
</head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}

    {% render 'chat-drawer' %}

    <div class="page-wrapper">
      <div id="header-group">
        {% sections 'header-group' %}
      </div>

      <script>
        /**
         * Sets `--header-height` and `--header-group-height` to measured values before first paint.
         *
         * A few CSS rules position content relative to the header at first paint — a hero sized to
         * the remaining viewport, a transparent header's negative margin. Without a measured value
         * those rules use the `60px` fallback from `sections/header.liquid`, and the content visibly
         * jumps once `header.js` corrects the values after load.
         *
         * Measuring forces layout mid-parse, so it only runs where a consuming rule exists.
         * Callers opt in: the transparent-header branch below, or `snippets/measure-header-heights.liquid`,
         * which any new first-paint consumer must render too.
         *
         * Measures once per page; after load, header.js's ResizeObservers keep the values fresh.
         * The group-height walk mimics calculateHeaderGroupHeight() in utilities.js — keep them
         * in sync.
         */
        window.measureHeaderHeights = (function () {
          let measured = false;

          return function measureHeaderHeights() {
            if (measured) return;

            const header = document.querySelector('#header-component');
            const headerGroup = document.querySelector('#header-group');

            if (!header || !headerGroup) return;
            measured = true;

            const headerHeight = header.offsetHeight;

            let headerGroupHeight = 0;
            for (const element of headerGroup.children) {
              if (element instanceof HTMLElement) headerGroupHeight += element.offsetHeight;
            }

            /**
             * A transparent header is absolutely positioned, so the loop above counts its section
             * wrapper as 0px. When a section follows it in the group, header.liquid pushes that
             * section down by the header's height using a margin, which offsetHeight also
             * excludes — so the header's height has to be added back manually.
             */
            if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
              headerGroupHeight += headerHeight;
            }

            document.body.style.setProperty('--header-height', `${headerHeight}px`);
            document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);
          };
        })();

        /**
         * Transparent-header rules consume the measured heights at first paint on every
         * template, so the transparent case opts in globally here instead of per-section.
         */
        if (document.querySelector('#header-component')?.hasAttribute('transparent')) {
          measureHeaderHeights();
        }

        /**
         * Sets `--top-row-height`, consumed by the header underlays and submenus. Deferred to a
         * rAF so the height read doesn't force layout mid-parse, and scoped to the
         * header, where all consumers live, so the write only invalidates the header subtree.
         * Mimics the `--top-row-height` write in updateHeaderHeights() in utilities.js
         */
        (function setTopRowHeight() {
          const header = document.querySelector('#header-component');
          const headerTopRow = header?.querySelector('.header__row--top');
          if (!headerTopRow) return;

          window.requestAnimationFrame(function () {
            header.style.setProperty('--top-row-height', `${headerTopRow.getBoundingClientRect().height}px`);
          });
        })();

        /**
         * Sets `--transparent-header-offset-boolean` when the first section must offset itself
         * under a transparent header. The non-offset case relies on the `0` default declared in
         * sections/header.liquid — unlike updateTransparentHeaderOffset() in utilities.js, which
         * re-runs on editor changes and must write '0' to reset a previously written '1'.
         */
        (function updateTransparentHeaderOffset() {
          const header = document.querySelector('#header-component');
          const headerSection = document.querySelector('#header-group .header-section');
          if (!headerSection || !header?.hasAttribute('transparent')) return;

          const hasImmediateSection = headerSection.nextElementSibling?.classList.contains('shopify-section');
          if (!hasImmediateSection) {
            document.body.style.setProperty('--transparent-header-offset-boolean', '1');
          }
        })();

        /**
         * Sets the initial menu style (inline menu vs. drawer) on the header component.
         * Mimics setHeaderMenuStyle() in utilities.js
         */
        (function setHeaderMenuStyle() {
          const headerComponent = document.querySelector('#header-component');
          if (headerComponent) {
            const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
            const overflowList = headerComponent.querySelector('overflow-list');
            const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
            headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
          }
        })();
      </script>

      <main
        id="MainContent"
        class="content-for-layout"
        role="main"
        data-page-transition-enabled="{{ settings.page_transition_enabled }}"
        data-product-transition="{{ settings.transition_to_main_product }}"
        data-template="{{ template }}"
      >
        {{ content_for_layout }}
      </main>

      <footer>
        {% sections 'footer-group' %}
      </footer>
    </div>

    {% render 'cart-drawer', render_wrapper: true %}
    {% render 'theme-drawer' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
    
<script id="amoura-motion-observer">
  (() => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const targets = [...document.querySelectorAll('[data-amoura-reveal],[data-amoura-mask]')];
    const reveal = new IntersectionObserver((entries) => {
      entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); reveal.unobserve(entry.target); } });
    }, { threshold: 0.08, rootMargin: '0px 0px -4% 0px' });
    targets.forEach((el) => reveal.observe(el));
    window.setTimeout(() => targets.forEach((el) => el.classList.add('is-visible')), 1800);
    const parallaxEls = [...document.querySelectorAll('[data-amoura-parallax]')];
    let ticking = false;
    const update = () => {
      const vh = window.innerHeight;
      parallaxEls.forEach((el) => {
        const r = el.getBoundingClientRect();
        if (r.bottom < 0 || r.top > vh) return;
        const p = (r.top + r.height/2 - vh/2) / vh;
        el.style.transform = `scale(1.035) translateY(${p * -10}px)`;
      });
      ticking = false;
    };
    window.addEventListener('scroll', () => { if (!ticking) { requestAnimationFrame(update); ticking = true; } }, {passive:true});
    update();
  })();
</script><script id="amoura-locale-labels">
(() => {
  const clubLabel = {{ request.locale.iso_code | json }} === 'en' ? 'Club Amoura' : 'Klub Amoura';
  document.querySelectorAll('a[href*="/pages/klub-amoura"], a[href*="/en/pages/klub-amoura"]').forEach((link) => {
    const text = link.textContent.trim();
    if (text === 'Club Amoura' || text === 'Klub Amoura') link.textContent = clubLabel;
  });
})();
</script><script id="amoura-interaction-tracking">
(() => {
  const emit = (name, detail = {}) => {
    const payload = { event: 'amoura_interaction', action: name, template: '{{ template }}', locale: '{{ request.locale.iso_code }}', ...detail };
    window.dispatchEvent(new CustomEvent('amoura:interaction', { detail: payload }));
    if (Array.isArray(window.dataLayer)) window.dataLayer.push(payload);
  };
  document.addEventListener('click', (e) => {
    const el = e.target.closest('[data-amoura-track]');
    if (!el) return;
    emit(el.getAttribute('data-amoura-track'), { href: el.getAttribute('href') || null });
  });
  document.addEventListener('submit', (e) => {
    if (e.target.closest('.amx-founding')) emit('founding50_form_submit');
  });
})();
</script>
</body>
</html>
