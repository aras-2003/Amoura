{% assign club_url = section.settings.club_url | default: '/pages/klub-amoura' %}
<section class="ac" aria-labelledby="ac-title-{{ section.id }}">
  <div class="ac-hero">
    <div class="ac-hero__copy">
      <p class="ac-eyebrow">{{ 'amoura_club.kicker' | t }}</p>
      {% if section.settings.teaser %}
        <h2 id="ac-title-{{ section.id }}">{{ 'amoura_club.teaser_title' | t }}</h2>
        <p class="ac-lead">{{ 'amoura_club.teaser_body' | t }}</p>
        <a class="ac-button" href="{{ club_url }}">{{ 'amoura_club.teaser_cta' | t }} <span aria-hidden="true">↗</span></a>
      {% else %}
        <h1 id="ac-title-{{ section.id }}">{{ 'amoura_club.title' | t }}</h1>
        <p class="ac-lead">{{ 'amoura_club.lead' | t }}</p>
        <div class="ac-actions"><a class="ac-button" href="#ac-ritual-{{ section.id }}">{{ 'amoura_club.cta' | t }} <span aria-hidden="true">↓</span></a><a class="ac-link" href="#ac-join-{{ section.id }}">{{ 'amoura_club.join' | t }}</a></div>
      {% endif %}
      <p class="ac-hero__foot">AMOURA <span>–</span> {{ 'amoura_club.caption' | t }}</p>
    </div>
    <figure class="ac-hero__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1600 | image_tag: widths: '480, 800, 1200, 1600', sizes: '(max-width: 760px) 100vw, 50vw', class: 'ac-photo' }}
      {% else %}
        <img class="ac-photo" src="{{ 'amoura-morning.webp' | asset_url }}" width="896" height="1200" alt="{{ 'amoura_club.alt' | t }}" {% if section.settings.teaser %}loading="lazy"{% else %}fetchpriority="high"{% endif %}>
      {% endif %}
      <figcaption>01 / {{ 'amoura_club.caption' | t }}</figcaption>
    </figure>
  </div>
  {% unless section.settings.teaser %}
  <div class="ac-ritual ac-wrap" id="ac-ritual-{{ section.id }}">
    <div><p class="ac-eyebrow">{{ 'amoura_club.today' | t }}</p><h2>{{ 'amoura_club.ritual_title' | t }}</h2><p class="ac-lead">{{ 'amoura_club.ritual_lead' | t }}</p><p class="ac-note">{{ 'amoura_club.note' | t }}</p></div>
    <div class="ac-rituals">
      {% for i in (1..3) %}
        {% case i %}{% when 1 %}{% assign duration = 'one' %}{% when 2 %}{% assign duration = 'two' %}{% else %}{% assign duration = 'three' %}{% endcase %}
        {% assign duration_key = 'amoura_club.' | append: duration %}
        {% assign title_key = 'amoura_club.r' | append: i | append: '_title' %}
        {% assign body_key = 'amoura_club.r' | append: i | append: '_body' %}
        <details class="ac-ritual-card" {% if forloop.first %}open{% endif %}>
          <summary><span class="ac-number">0{{ i }}</span><span>{{ duration_key | t }}</span><span class="ac-plus" aria-hidden="true">+</span></summary>
          <div class="ac-ritual-card__body"><h3>{{ title_key | t }}</h3><p>{{ body_key | t }}</p></div>
        </details>
      {% endfor %}
    </div>
  </div>
  {% if section.settings.blog != blank and section.settings.blog.articles_count > 0 %}
  <div class="ac-journal ac-wrap"><div class="ac-journal__heading"><p class="ac-eyebrow">{{ 'amoura_club.editorial' | t }}</p><h2>{{ 'amoura_club.editorial_title' | t }}</h2><a class="ac-link" href="{{ section.settings.blog.url }}">{{ 'amoura_club.all' | t }} ↗</a></div>
    <div class="ac-articles">{% for article in section.settings.blog.articles limit: 2 %}<a class="ac-article" href="{{ article.url }}">{% if article.image %}{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 800', sizes: '(max-width: 760px) 100vw, 30vw' }}{% endif %}<h3>{{ article.title | escape }}</h3><span class="ac-link">{{ 'amoura_club.read' | t }} ↗</span></a>{% endfor %}</div>
  </div>{% endif %}
  <div class="ac-join" id="ac-join-{{ section.id }}"><div class="ac-wrap ac-join__inner">
    <div><p class="ac-eyebrow">{{ 'amoura_club.status' | t }}</p><h2>{{ 'amoura_club.club_title' | t }}</h2><p class="ac-lead">{{ 'amoura_club.club_body' | t }}</p></div>
    <div class="ac-signup">
    {% assign form_id = 'AmouraClub-' | append: section.id %}
    {% form 'contact', id: form_id %}
      {% if form.posted_successfully? %}<p class="ac-message" role="status" tabindex="-1">{{ 'amoura_club.success' | t }}</p>{% else %}
      {% if form.errors %}<div class="ac-message" role="alert">{{ 'amoura_club.error' | t }} {{ form.errors | default_errors }}</div>{% endif %}
      <input type="hidden" name="contact[body]" value="Request for an Amoura Club opening notification">
      <label for="ac-email-{{ section.id }}">{{ 'amoura_club.email' | t }}</label>
      <input id="ac-email-{{ section.id }}" name="contact[email]" type="email" autocomplete="email" required value="{{ form.email | escape }}" aria-describedby="ac-privacy-{{ section.id }}" {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}>
      <button class="ac-button" type="submit">{{ 'amoura_club.submit' | t }} <span aria-hidden="true">↗</span></button>
      <p class="ac-note" id="ac-privacy-{{ section.id }}">{{ 'amoura_club.privacy' | t }} {% if shop.privacy_policy.url != blank %}<a href="{{ shop.privacy_policy.url }}">{{ 'amoura_club.policy' | t }}</a>{% endif %}</p>
      {% endif %}
    {% endform %}
    </div>
    <div class="ac-planned"><p class="ac-eyebrow">{{ 'amoura_club.planned' | t }}</p><div>{% for i in (1..3) %}{% assign pk = 'amoura_club.p' | append: i %}{% assign pb = pk | append: '_body' %}<article><span class="ac-number">0{{ i }}</span><h3>{{ pk | t }}</h3><p>{{ pb | t }}</p></article>{% endfor %}</div></div>
  </div></div>
  {% endunless %}
</section>

{% stylesheet %}
.ac{
  --ac-paper:#F4EDE7;
  --ac-ink:#4A102A;
  --ac-dark:#30272B;
  --ac-text:#3E3337;
  --ac-muted:#76616A;
  --ac-line:#D8C8CF;
  --ac-rose:#C7A7B5;
  --ac-soft:#EEE4E0;
  background:var(--ac-paper);
  color:var(--ac-ink);
  font-family:Arial,sans-serif
}
.ac *{box-sizing:border-box;min-width:0}
.ac h1,.ac h2,.ac h3,.ac p,.ac figure{margin:0}
.ac a{color:inherit}
.ac h1,.ac h2,.ac h3{font-family:Georgia,'Times New Roman',serif;font-weight:400;text-wrap:balance}
.ac h1,.ac-hero h2{font-size:clamp(54px,6.6vw,104px);line-height:.96;letter-spacing:-.048em;white-space:pre-line}
.ac h2{font-size:clamp(38px,4.3vw,64px);line-height:1;letter-spacing:-.034em;white-space:pre-line}
.ac h3{font-size:clamp(25px,2vw,31px);line-height:1.08}
.ac p{line-height:1.68;color:var(--ac-text)}
.ac-eyebrow{display:flex;align-items:center;gap:14px;font-size:11px;letter-spacing:.18em;font-weight:500;text-transform:uppercase;color:var(--ac-muted)}
.ac-eyebrow:before{content:"";width:38px;height:1px;background:color-mix(in srgb,var(--ac-ink) 28%,transparent)}
.ac-wrap{width:min(1480px,calc(100% - clamp(48px,8vw,128px)));margin-inline:auto;padding-block:clamp(64px,7vw,96px)}

.ac-hero{display:grid;grid-template-columns:minmax(0,1.04fr) minmax(420px,.96fr);width:min(1600px,calc(100% - clamp(48px,7vw,112px)));margin:0 auto;padding:clamp(38px,5vw,72px) 0 clamp(64px,7vw,104px);gap:clamp(42px,6vw,96px);align-items:center}
.ac-hero__copy{display:flex;align-items:flex-start;flex-direction:column;justify-content:center}
.ac-hero__copy>.ac-eyebrow{margin-bottom:28px}
.ac-lead{font-size:18px;max-width:42ch}
.ac-hero .ac-lead{margin:28px 0 30px}
.ac-actions{display:flex;gap:22px;align-items:center;flex-wrap:wrap}
.ac-button{min-height:50px;display:inline-flex;align-items:center;justify-content:space-between;gap:28px;background:var(--ac-ink);color:var(--ac-paper)!important;border:1px solid var(--ac-ink);padding:14px 20px;text-decoration:none;font:inherit;font-size:14px;cursor:pointer;transition:background .25s,transform .25s}
.ac-button:hover{background:var(--ac-dark);transform:translateY(-2px)}
.ac-link{display:inline-flex;align-items:center;min-height:42px;text-decoration:underline;text-underline-offset:6px;font-size:14px}
.ac-hero__foot{margin-top:48px!important;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--ac-muted)!important}
.ac-hero__foot span{padding:0 10px}
.ac-hero__media{position:relative;min-height:610px;overflow:hidden;background:var(--ac-soft)}
.ac-hero__media:after{content:"";position:absolute;inset:0;border:1px solid rgba(74,16,42,.08);pointer-events:none}
.ac-photo{display:block;width:100%;height:100%;position:absolute;object-fit:cover;filter:saturate(.84) contrast(.96)}
.ac-hero figcaption{position:absolute;bottom:18px;left:20px;right:20px;color:#fff;font-size:11px;letter-spacing:.08em;text-transform:uppercase;text-shadow:0 1px 8px rgba(32,20,26,.55)}

.ac-ritual{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:clamp(56px,7vw,104px);scroll-margin-top:110px;border-top:1px solid var(--ac-line)}
.ac-ritual h2{margin:22px 0 18px}
.ac-ritual .ac-note{margin-top:28px;color:var(--ac-muted);max-width:40ch}
.ac-note{font-size:13px;line-height:1.6;color:var(--ac-muted)}
.ac-rituals{border-top:1px solid var(--ac-line)}
.ac-ritual-card{border-bottom:1px solid var(--ac-line)}
.ac-ritual-card summary{list-style:none;min-height:72px;display:grid;grid-template-columns:44px 1fr auto;align-items:center;gap:20px;cursor:pointer;font-size:17px;color:var(--ac-ink)}
.ac-ritual-card summary::-webkit-details-marker{display:none}
.ac-number{font-size:10px;letter-spacing:.16em;color:var(--ac-muted)}
.ac-plus{font-size:22px;font-weight:300;transition:transform .3s}
.ac-ritual-card[open] .ac-plus{transform:rotate(45deg)}
.ac-ritual-card__body{padding:0 38px 30px 64px}
.ac-ritual-card__body p{font-size:15px;margin-top:12px;max-width:44rem}

.ac-journal{border-top:1px solid var(--ac-line);display:grid;grid-template-columns:minmax(0,.72fr) minmax(0,1.28fr);gap:clamp(48px,6vw,88px)}
.ac-journal h2{margin:20px 0}
.ac-journal__heading{align-self:start}
.ac-articles{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.ac-article{text-decoration:none}
.ac-article img{width:100%;aspect-ratio:4/5;object-fit:cover;display:block;margin-bottom:18px;filter:saturate(.82)}
.ac-article h3{font-size:26px;margin-bottom:12px}
.ac-article .ac-link{font-size:13px}

.ac-join{background:var(--ac-dark);color:var(--ac-paper);scroll-margin-top:100px}
.ac-join p{color:rgba(244,237,231,.76)}
.ac-join .ac-eyebrow{color:rgba(244,237,231,.58)}
.ac-join .ac-eyebrow:before{background:rgba(244,237,231,.28)}
.ac-join__inner{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:56px 86px}
.ac-join h2{margin:22px 0 18px;color:var(--ac-paper)}
.ac-signup{align-self:center}
.ac-signup label{font-size:13px;display:block;margin-bottom:10px;color:rgba(244,237,231,.78)}
.ac-signup input[type=email]{width:100%;min-height:54px;background:transparent;color:inherit;border:1px solid rgba(244,237,231,.35);font:inherit;padding:14px;margin-bottom:12px;border-radius:0}
.ac-signup .ac-button{width:100%;background:var(--ac-paper);color:var(--ac-dark)!important;border-color:var(--ac-paper)}
.ac-signup .ac-note{margin-top:16px;color:rgba(244,237,231,.62)}
.ac-message{padding:20px;border:1px solid rgba(244,237,231,.35)}
.ac-planned{grid-column:1/-1;border-top:1px solid rgba(244,237,231,.16);padding-top:30px}
.ac-planned>div{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin-top:28px;border-top:1px solid rgba(244,237,231,.12)}
.ac-planned article{padding:26px 28px 8px 0;border-right:1px solid rgba(244,237,231,.12)}
.ac-planned article+article{padding-left:28px}
.ac-planned article:last-child{border-right:0}
.ac-planned h3{margin:14px 0 10px;color:var(--ac-paper)}
.ac-planned article p{font-size:14px;color:rgba(244,237,231,.68)}
.ac-join .ac-number{color:rgba(244,237,231,.45)}
.ac :focus-visible{outline:2px solid currentColor;outline-offset:5px}

@media(prefers-reduced-motion:no-preference){
  .ac-hero__copy h1,.ac-hero__copy h2{animation:ac-arrive .85s ease both}
  .ac-hero__copy>.ac-lead{animation:ac-arrive 1s .1s both}
  .ac-ritual-card[open] .ac-ritual-card__body{animation:ac-arrive .3s both}
  @keyframes ac-arrive{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
}
@media(max-width:1100px){
  .ac-hero{grid-template-columns:1fr 1fr;width:calc(100% - 64px);gap:42px}
  .ac-hero__media{min-height:540px}
  .ac-ritual,.ac-journal,.ac-join__inner{gap:42px}
}
@media(max-width:850px){
  .ac-hero{grid-template-columns:1fr;width:calc(100% - 44px);padding-top:38px}
  .ac-hero__media{min-height:0;height:520px}
  .ac-ritual,.ac-journal,.ac-join__inner{grid-template-columns:1fr}
  .ac-articles{grid-template-columns:1fr 1fr}
  .ac-planned>div{grid-template-columns:1fr}
  .ac-planned article,.ac-planned article+article{padding:22px 0;border-right:0;border-bottom:1px solid rgba(244,237,231,.12)}
  .ac-planned article:last-child{border-bottom:0}
}
@media(max-width:599px){
  .ac-wrap{width:calc(100% - 40px);padding-block:52px}
  .ac-hero{width:calc(100% - 40px);padding:34px 0 58px}
  .ac-hero__copy>.ac-eyebrow{margin-bottom:22px}
  .ac h1,.ac-hero h2{font-size:clamp(50px,14vw,66px)}
  .ac-hero__media{height:390px}
  .ac-photo{object-position:center 58%}
  .ac-hero__foot{margin-top:32px!important}
  .ac-actions{gap:14px}
  .ac-button{width:100%}
  .ac-link{min-height:38px}
  .ac-articles{grid-template-columns:1fr;gap:30px}
  .ac-ritual-card summary{grid-template-columns:36px 1fr auto;gap:14px}
  .ac-ritual-card__body{padding-left:50px;padding-right:0}
  .ac-join .ac-lead{font-size:16px}
}
@media(prefers-reduced-motion:reduce){.ac *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
{% endstylesheet %}
{% schema %}
{
  "name": "Amoura \u00b7 Klub",
  "settings": [
    {
      "type": "checkbox",
      "id": "teaser",
      "label": "Compact homepage invitation",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial photograph"
    },
    {
      "type": "url",
      "id": "club_url",
      "label": "Club page"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Editorial blog"
    }
  ],
  "presets": [
    {
      "name": "Amoura \u00b7 Klub"
    }
  ]
}
{% endschema %}
