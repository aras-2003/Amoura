{% assign club_url = section.settings.club_url | default: '/pages/klub-amoura' %}
<section class="ac" aria-labelledby="ac-title-{{ section.id }}">
  <div class="ac-hero">
    <div class="ac-hero__copy">
      <p class="ac-eyebrow">{{ 'amoura_club.kicker' | t }}</p>
      {% if section.settings.teaser %}
        <h2 id="ac-title-{{ section.id }}">{{ 'amoura_club.teaser_title' | t }}</h2>
        <p class="ac-lead">{{ 'amoura_club.teaser_body' | t }}</p>
        <a class="ac-button" href="{{ club_url }}">{{ 'amoura_club.teaser_cta' | t }} <span aria-hidden="true">↗</span></a>
      {% else %}
        <h1 id="ac-title-{{ section.id }}">{{ 'amoura_club.title' | t }}</h1>
        <p class="ac-lead">{{ 'amoura_club.lead' | t }}</p>
        <div class="ac-actions"><a class="ac-button" href="#ac-ritual-{{ section.id }}">{{ 'amoura_club.cta' | t }} <span aria-hidden="true">↓</span></a><a class="ac-link" href="#ac-join-{{ section.id }}">{{ 'amoura_club.join' | t }}</a></div>
      {% endif %}
      <p class="ac-hero__foot">AMOURA <span>–</span> {{ 'amoura_club.caption' | t }}</p>
    </div>
    <figure class="ac-hero__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1600 | image_tag: widths: '480, 800, 1200, 1600', sizes: '(max-width: 760px) 100vw, 50vw', class: 'ac-photo' }}
      {% else %}
        <img class="ac-photo" src="{{ 'amoura-morning.webp' | asset_url }}" width="896" height="1200" alt="{{ 'amoura_club.alt' | t }}" {% if section.settings.teaser %}loading="lazy"{% else %}fetchpriority="high"{% endif %}>
      {% endif %}
      <figcaption>01 / {{ 'amoura_club.caption' | t }}</figcaption>
    </figure>
  </div>
  {% unless section.settings.teaser %}
  <div class="ac-ritual ac-wrap" id="ac-ritual-{{ section.id }}">
    <div><p class="ac-eyebrow">{{ 'amoura_club.today' | t }}</p><h2>{{ 'amoura_club.ritual_title' | t }}</h2><p class="ac-lead">{{ 'amoura_club.ritual_lead' | t }}</p><p class="ac-note">{{ 'amoura_club.note' | t }}</p></div>
    <div class="ac-rituals">
      {% for i in (1..3) %}
        {% case i %}{% when 1 %}{% assign duration = 'one' %}{% when 2 %}{% assign duration = 'two' %}{% else %}{% assign duration = 'three' %}{% endcase %}
        {% assign duration_key = 'amoura_club.' | append: duration %}
        {% assign title_key = 'amoura_club.r' | append: i | append: '_title' %}
        {% assign body_key = 'amoura_club.r' | append: i | append: '_body' %}
        <details class="ac-ritual-card" {% if forloop.first %}open{% endif %}>
          <summary><span class="ac-number">0{{ i }}</span><span>{{ duration_key | t }}</span><span class="ac-plus" aria-hidden="true">+</span></summary>
          <div class="ac-ritual-card__body"><h3>{{ title_key | t }}</h3><p>{{ body_key | t }}</p></div>
        </details>
      {% endfor %}
    </div>
  </div>
  {% if section.settings.blog != blank and section.settings.blog.articles_count > 0 %}
  <div class="ac-journal ac-wrap"><div class="ac-journal__heading"><p class="ac-eyebrow">{{ 'amoura_club.editorial' | t }}</p><h2>{{ 'amoura_club.editorial_title' | t }}</h2><a class="ac-link" href="{{ section.settings.blog.url }}">{{ 'amoura_club.all' | t }} ↗</a></div>
    <div class="ac-articles">{% for article in section.settings.blog.articles limit: 2 %}<a class="ac-article" href="{{ article.url }}">{% if article.image %}{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 800', sizes: '(max-width: 760px) 100vw, 30vw' }}{% endif %}<h3>{{ article.title | escape }}</h3><span class="ac-link">{{ 'amoura_club.read' | t }} ↗</span></a>{% endfor %}</div>
  </div>{% endif %}
  <div class="ac-join" id="ac-join-{{ section.id }}"><div class="ac-wrap ac-join__inner">
    <div><p class="ac-eyebrow">{{ 'amoura_club.status' | t }}</p><h2>{{ 'amoura_club.club_title' | t }}</h2><p class="ac-lead">{{ 'amoura_club.club_body' | t }}</p></div>
    <div class="ac-signup">
    {% assign form_id = 'AmouraClub-' | append: section.id %}
    {% form 'contact', id: form_id %}
      {% if form.posted_successfully? %}<p class="ac-message" role="status" tabindex="-1">{{ 'amoura_club.success' | t }}</p>{% else %}
      {% if form.errors %}<div class="ac-message" role="alert">{{ 'amoura_club.error' | t }} {{ form.errors | default_errors }}</div>{% endif %}
      <input type="hidden" name="contact[body]" value="Request for an Amoura Club opening notification">
      <label for="ac-email-{{ section.id }}">{{ 'amoura_club.email' | t }}</label>
      <input id="ac-email-{{ section.id }}" name="contact[email]" type="email" autocomplete="email" required value="{{ form.email | escape }}" aria-describedby="ac-privacy-{{ section.id }}" {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}>
      <button class="ac-button" type="submit">{{ 'amoura_club.submit' | t }} <span aria-hidden="true">↗</span></button>
      <p class="ac-note" id="ac-privacy-{{ section.id }}">{{ 'amoura_club.privacy' | t }} {% if shop.privacy_policy.url != blank %}<a href="{{ shop.privacy_policy.url }}">{{ 'amoura_club.policy' | t }}</a>{% endif %}</p>
      {% endif %}
    {% endform %}
    </div>
    <div class="ac-planned"><p class="ac-eyebrow">{{ 'amoura_club.planned' | t }}</p><div>{% for i in (1..3) %}{% assign pk = 'amoura_club.p' | append: i %}{% assign pb = pk | append: '_body' %}<article><span class="ac-number">0{{ i }}</span><h3>{{ pk | t }}</h3><p>{{ pb | t }}</p></article>{% endfor %}</div></div>
  </div></div>
  {% endunless %}
</section>

{% stylesheet %}

.ac{--ac-paper:#f4ede7;--ac-ink:#4a102a;--ac-muted:#744d5e;background:var(--ac-paper);color:var(--ac-ink);font-family:Arial,sans-serif}
.ac *{box-sizing:border-box}.ac h1,.ac h2,.ac h3,.ac p,.ac figure{margin:0}.ac a{color:inherit}.ac h1,.ac h2,.ac h3{font-family:Georgia,'Times New Roman',serif;font-weight:400;text-wrap:balance}.ac h1,.ac-hero h2{font-size:clamp(56px,7.4vw,112px);line-height:.98;letter-spacing:-.055em;white-space:pre-line}.ac h2{font-size:clamp(36px,4.1vw,62px);line-height:1.04;letter-spacing:-.035em;white-space:pre-line}.ac h3{font-size:30px;line-height:1.15}.ac p{line-height:1.65}.ac-eyebrow{font-size:12px;letter-spacing:.16em;font-weight:600;text-transform:uppercase}.ac-hero{display:grid;grid-template-columns:1fr 1fr;max-width:1800px;margin:auto}.ac-hero__copy{padding:clamp(32px,6vw,88px);display:flex;align-items:flex-start;flex-direction:column;justify-content:center}.ac-hero__copy>.ac-eyebrow{margin-bottom:40px}.ac-lead{font-size:18px;max-width:38ch}.ac-hero .ac-lead{margin:28px 0 32px}.ac-actions{display:flex;gap:24px;align-items:center;flex-wrap:wrap}.ac-button{min-height:52px;display:inline-flex;align-items:center;justify-content:space-between;gap:28px;background:var(--ac-ink);color:var(--ac-paper)!important;border:1px solid var(--ac-ink);padding:15px 23px;text-decoration:none;font:inherit;font-size:15px;cursor:pointer;transition:background .25s,transform .25s}.ac-button:hover{background:#65223e;transform:translateY(-2px)}.ac-link{display:inline-flex;align-items:center;min-height:44px;text-decoration:underline;text-underline-offset:6px;font-size:15px}.ac-hero__foot{margin-top:60px!important;font-size:11px;letter-spacing:.06em}.ac-hero__foot span{padding:0 12px}.ac-hero__media{position:relative;min-height:630px;overflow:hidden;background:#d3bca9}.ac-photo{display:block;width:100%;height:100%;position:absolute;object-fit:cover}.ac-hero figcaption{position:absolute;bottom:22px;left:24px;right:24px;color:#fff;font-size:12px;text-shadow:0 1px 8px #24121b}.ac-wrap{max-width:1320px;margin:auto;padding:88px clamp(24px,5vw,72px)}.ac-ritual{display:grid;grid-template-columns:1fr 1fr;gap:80px;scroll-margin-top:110px}.ac-ritual h2{margin:22px 0}.ac-note{font-size:13px;line-height:1.6}.ac-ritual .ac-note{margin-top:32px;color:var(--ac-muted);max-width:36ch}.ac-ritual-card{border-top:1px solid #c8afb6}.ac-ritual-card:last-child{border-bottom:1px solid #c8afb6}.ac-ritual-card summary{list-style:none;min-height:72px;display:flex;align-items:center;gap:26px;cursor:pointer;font-size:18px}.ac-ritual-card summary::-webkit-details-marker{display:none}.ac-number{font-size:12px;letter-spacing:.1em}.ac-plus{margin-left:auto;font-size:26px;font-weight:300;transition:transform .3s}.ac-ritual-card[open] .ac-plus{transform:rotate(45deg)}.ac-ritual-card__body{padding:2px 30px 30px 42px}.ac-ritual-card__body p{font-size:16px;margin-top:15px}.ac-journal{border-top:1px solid #c8afb6;display:grid;grid-template-columns:.85fr 1.6fr;gap:60px}.ac-journal h2{margin:24px 0}.ac-articles{display:grid;grid-template-columns:1fr 1fr;gap:24px}.ac-article{text-decoration:none}.ac-article img{width:100%;aspect-ratio:4/5;object-fit:cover;display:block;margin-bottom:22px}.ac-article h3{font-size:27px;margin-bottom:16px}.ac-join{background:#42152b;color:#f4ede7;scroll-margin-top:100px}.ac-join__inner{display:grid;grid-template-columns:1fr 1fr;gap:64px 80px}.ac-join h2{margin:24px 0}.ac-signup{align-self:center}.ac-signup label{font-size:15px;display:block;margin-bottom:12px}.ac-signup input[type=email]{width:100%;min-height:56px;background:transparent;color:inherit;border:1px solid #b295a2;font:inherit;padding:14px;margin-bottom:14px;border-radius:0}.ac-signup .ac-button{width:100%;background:#f4ede7;color:#42152b!important;border-color:#f4ede7}.ac-signup .ac-note{margin-top:20px;color:#e0cdd6}.ac-message{padding:24px;border:1px solid #b295a2}.ac-planned{grid-column:1/-1;border-top:1px solid #865e70;padding-top:32px}.ac-planned>div{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;margin-top:32px}.ac-planned h3{margin:16px 0 12px}.ac-planned article p{font-size:15px;color:#e0cdd6}.ac :focus-visible{outline:2px solid currentColor;outline-offset:5px}
@media(prefers-reduced-motion:no-preference){.ac-hero__copy h1,.ac-hero__copy h2{animation:ac-arrive .85s ease both}.ac-hero__copy>.ac-lead{animation:ac-arrive 1s .1s both}.ac-ritual-card[open] .ac-ritual-card__body{animation:ac-arrive .3s both}@keyframes ac-arrive{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}}
@media(max-width:1000px){.ac-hero__copy{padding:40px 32px}.ac-hero__media{min-height:580px}.ac-ritual,.ac-journal,.ac-join__inner{gap:40px}.ac-hero__foot{margin-top:36px!important}}
@media(max-width:760px){.ac-hero{grid-template-columns:1fr}.ac-hero__copy{padding:40px 24px}.ac-hero__copy>.ac-eyebrow{margin-bottom:28px}.ac-hero__media{min-height:0;height:390px}.ac-photo{object-position:center 58%}.ac h1,.ac-hero h2{font-size:66px}.ac-hero__foot{font-size:10px;letter-spacing:0}.ac-hero__foot span{padding:0 6px}.ac-wrap{padding:52px 24px}.ac-ritual,.ac-journal,.ac-join__inner{grid-template-columns:1fr;gap:32px}.ac-ritual .ac-note{margin-top:20px}.ac-articles{gap:18px}.ac-article h3{font-size:23px}.ac-planned>div{grid-template-columns:1fr;gap:26px}.ac-planned article{border-bottom:1px solid #865e70;padding-bottom:24px}.ac-ritual-card__body{padding-left:0}.ac-join .ac-lead{font-size:17px}}
@media(prefers-reduced-motion:reduce){.ac *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}

{% endstylesheet %}
{% schema %}
{
  "name": "Amoura \u00b7 Klub",
  "settings": [
    {
      "type": "checkbox",
      "id": "teaser",
      "label": "Compact homepage invitation",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial photograph"
    },
    {
      "type": "url",
      "id": "club_url",
      "label": "Club page"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Editorial blog"
    }
  ],
  "presets": [
    {
      "name": "Amoura \u00b7 Klub"
    }
  ]
}
{% endschema %}
