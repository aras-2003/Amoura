

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
>
  {% liquid
    assign total_blocks = section.blocks.size

    # Grid layout calculations
    assign grid_columns = total_blocks | at_most: 4

    # Calculate last row counts using modulo arithmetic
    # last_row_count = (total_blocks - 1) % N + 1
    assign last_row_count = total_blocks | minus: 1 | modulo: 4 | plus: 1
    assign tablet_last_row_count = total_blocks | minus: 1 | modulo: 2 | plus: 1

    # Check if there are orphaned elements (single item in last row)
    assign has_isolated_grid_item_desktop = false
    assign has_isolated_grid_item_tablet = false

    if total_blocks > 4 and last_row_count == 1
      assign has_isolated_grid_item_desktop = true
    endif

    if total_blocks == 5
      assign has_isolated_grid_item_tablet = true
    endif
  %}
  <div
    class="
      footer-content
      {% if section.settings.editorial_footer %}footer-content--editorial{% endif %}
      spacing-style
      {% if has_isolated_grid_item_desktop %}footer-content--isolated-grid-item-desktop{% endif %}
      {% if has_isolated_grid_item_tablet %}footer-content--isolated-grid-item-tablet{% endif %}
    "
    style="
      {%  render 'spacing-style', settings: section.settings %}
      --footer-gap: {{ section.settings.gap }}px;
      --grid-columns: {{ grid_columns }};
      --last-row-count: {{ last_row_count }};
      --tablet-last-row-count: {{ tablet_last_row_count }};
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .footer-content {
    contain: content;
    content-visibility: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--footer-gap);
    align-items: start;
  }

  .footer-content .menu__heading__default {
    font-weight: var(--font-heading--weight);
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .footer-content {
      grid-template-columns: repeat(min(var(--grid-columns), 3), 1fr);
      grid-auto-flow: row;
    }

    .footer-content[style*='--grid-columns: 4'] {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-content--isolated-grid-item-tablet > :last-child {
      grid-column: 1 / -1;
    }
  }

  @media screen and (min-width: 990px) {
    .footer-content {
      grid-template-columns: repeat(var(--grid-columns), 1fr);
    }

    /* Single item centered */
    .footer-content[style*='--grid-columns: 1'] {
      justify-items: center;
    }

    .footer-content--isolated-grid-item-desktop > :last-child {
      grid-column: 1 / -1;
    }
  }

{% endstylesheet %}

{% if section.settings.editorial_footer %}
<style>
  .footer-content.footer-content--editorial { contain: none; content-visibility: visible; color: #48172c; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 20px; max-width: 920px; margin-inline: auto; }
  .footer-content.footer-content--editorial > :first-child { grid-column: 1 / -1; }
  .footer-content.footer-content--editorial h2 { font-family: var(--font-heading--family); font-size: clamp(32px, 3.3vw, 46px); font-weight: 400; letter-spacing: -.035em; line-height: 1; margin: 0 0 6px; }
  .footer-content.footer-content--editorial p { margin: 0; color: inherit; }
  .footer-content.footer-content--editorial strong { display: block; margin-bottom: 10px; font-size: 11px; letter-spacing: .11em; text-transform: uppercase; }
  .footer-content.footer-content--editorial br { display: none; }
  .footer-content.footer-content--editorial a { display: flex; align-items: center; min-height: 27px; width: fit-content; max-width: 100%; color: #48172c; font-size: 14px; line-height: 1.3; text-decoration: none; text-underline-offset: 5px; }
  .footer-content.footer-content--editorial > :first-child p { font-size: 13px; line-height: 1.45; max-width: 17rem; }
  .footer-content.footer-content--editorial a:hover { text-decoration: underline; }
  .footer-content.footer-content--editorial a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  @media screen and (min-width: 990px) {
    .footer-content.footer-content--editorial { grid-template-columns: minmax(210px, 1.15fr) repeat(3, minmax(125px, .66fr)); column-gap: clamp(24px, 2.4vw, 38px); align-items: start; }
    .footer-content.footer-content--editorial > :first-child { grid-column: auto; }
  }
</style>
{% endif %}

{% if request.locale.iso_code == 'en' and section.settings.editorial_footer %}
<script>
  (() => {
    const footer = document.currentScript?.closest('.section-wrapper') || document;
    const replacements = new Map([
      ['/pages/klub-amoura', 'Club Amoura'],
      ['/blogs/wiedza', 'Articles'],
      ['/blogs/wiedza/od-czego-zaczac', 'Start here']
    ]);

    footer.querySelectorAll('a').forEach((link) => {
      const path = new URL(link.href, window.location.origin).pathname.replace(/^\/en(?=\/)/, '');
      const label = replacements.get(path);
      if (label) link.textContent = label;
    });
  })();
</script>
{% endif %}

